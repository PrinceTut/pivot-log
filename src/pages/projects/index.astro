---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndexMasthead from '../../components/IndexMasthead.astro';
import IndexEntry from '../../components/IndexEntry.astro';
import PipelineCard from '../../components/PipelineCard.astro';
import type { ResearchMeta } from '../../types';

// Self-updating: every .astro file in this folder with a `meta` export is listed.
const modules = import.meta.glob<{ meta: ResearchMeta }>('./*.astro', { eager: true });
const pieces = Object.entries(modules)
  .filter(([path]) => !path.endsWith('/index.astro'))
  .map(([, mod]) => mod.meta)
  .filter(Boolean)
  .sort((a, b) => b.date.localeCompare(a.date));

// Longer descriptions shown under each dek, matched by slug.
const descriptions: Record<string, string> = {
  'jev-system-one':
    'To test it on something real, I built a task router for a made up wealthtech firm: every piece of internal work gets classified into one of ten categories and sent to the cheapest Claude model that can handle it, instead of everything going to the most expensive one by default.',
  'rag-chunking-and-retrieval':
    'An independent evaluation harness comparing six chunking strategies and four retrieval strategies over twenty structurally complex legal contracts, with every result traced back to its exact mechanism rather than left as a leaderboard number.',
  'building-an-slm':
    "I built a full RAG-plus-fine-tuned-SLM pipeline for India-Switzerland cross-border tax questions. The basic idea was for the knowledge to be in a curated database chunked and retrieved and the fine-tuned model behaving according to my specific use case.",
};

const extras: Record<string, { href: string; label: string }> = {
  'jev-system-one': { href: '/mvp/pivotjev-router/', label: 'Open the MVP' },
};

// Builds still in progress (text from each project's own chat, approved in chat).
const pipeline = [
  {
    title: 'What Can a Parent Actually Change?',
    oneLiner: "A causal simulation of which parenting decisions actually change a child's adult earnings.",
    description: "I'm modelling which decisions a parent actually controls, from planning a child through high school, and whether any of them change the child's adult earnings. It started with Gladwell's Outliers. I wanted to flip his method: use only studies with as-if-random variation, put a cost on every lever, and publish whatever comes out, even if most levers barely matter.",
    buildingWith: ['Python', 'randomised trials and natural experiments', 'an evidence ledger', 'Claude'],
    comesOut: 'A paper, the simulation model, the evidence ledger as a dataset, and an interactive results explorer',
    icon: 'levers' as const,
  },
  {
    title: 'Pivot-ACM',
    oneLiner: "Matching each LLM task to a model that's good enough and costs less.",
    description: "I'm building a system that sends each LLM task to a cheaper model whenever that model can still do the job well. I started it because teams pay for expensive models on work a smaller one handles fine, like reading long documents. To test it properly, I built a 280-task benchmark, partly from real SEC filings and contracts.",
    buildingWith: ['Python', 'Claude Haiku, Sonnet and Opus', 'ModernBERT', 'SEC filings and CUAD contracts'],
    comesOut: 'A benchmark dataset and a router model',
    icon: 'scale' as const,
  },
];

// Intro copy as approved in chat (restored; an earlier zip had overwritten it).
const intro = "These are exercises I've done to build and break down systems, to understand the mechanisms behind building models, pipelines, and agents. Every piece here is something built out of curiosity.";
---

<BaseLayout title="Projects" description={intro} nav="gold">
  <IndexMasthead theme="gold" title="Projects" rows={[['*', 'PROJECTS']]} align="start" intro={intro} count={pieces.length} countLabel={pieces.length === 1 ? 'Build' : 'Builds'} />

  <section class="pipeline" aria-labelledby="pipeline-title">
    <h2 class="pipeline__title" id="pipeline-title">In the pipeline</h2>
    <div class="pipeline__grid">
      {pipeline.map((p) => <PipelineCard {...p} />)}
    </div>
  </section>

  <section class="list" aria-label="Builds">
    {pieces.map((piece, i) => (
      <IndexEntry
        href={`/projects/${piece.slug}`}
        slug={piece.slug}
        index={pieces.length - i}
        title={piece.title}
        dek={piece.dek}
        description={descriptions[piece.slug]}
        stats={piece.stats}
        extra={extras[piece.slug]}
      />
    ))}
  </section>
</BaseLayout>

<style>
  .list { padding: var(--space-16) var(--gutter) 0; max-width: 1500px; margin: 0 auto; }
  .pipeline { padding: var(--space-12) var(--gutter) 0; max-width: 1500px; margin: 0 auto; }
  .pipeline__title { margin: 0 0 28px; font-family: var(--font-mono); font-weight: 700; font-size: 14px; letter-spacing: 0.06em; text-transform: uppercase; }
  .pipeline__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr)); gap: 32px var(--space-6); }
  @media (max-width: 639px) { .list { padding-top: var(--space-8); } }
</style>

<script>
  // Scroll focus: the entry nearest the viewport centre stays at full opacity, the
  // rest dim to 0.75 (colour stays reserved for data). Only runs with 2+ entries.
  function setupProjectFocus() {
    const entries = document.querySelectorAll<HTMLElement>('[data-scroll-entry]');
    if (entries.length < 2) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const observer = new IntersectionObserver((obs) => {
      obs.forEach((o) => {
        if (!o.isIntersecting) return;
        entries.forEach((e) => e.classList.toggle('dimmed', e !== o.target));
      });
    }, { rootMargin: '-45% 0px -45% 0px', threshold: 0 });
    entries.forEach((e) => observer.observe(e));
  }
  document.addEventListener('astro:page-load', setupProjectFocus);
</script>
