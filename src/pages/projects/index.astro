---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndexEntry from '../../components/IndexEntry.astro';
import type { ResearchMeta } from '../../types';

const modules = import.meta.glob<{ meta: ResearchMeta }>('./*.astro', {
  eager: true,
});

const pieces = Object.entries(modules)
  .filter(([path]) => !path.endsWith('/index.astro'))
  .map(([, mod]) => mod.meta)
  .filter(Boolean)
  .sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout
  title="Projects"
  description="Independent write-ups on how systems actually behave — built, tested, and measured from the ground up."
>
  <div class="projects-index">
    <header>
      <p class="kicker">Pivot Log Projects</p>
      <h1>Projects</h1>
      <p class="intro">
        These are exercises I've done to build and break down systems, to
        understand the mechanisms behind building models, pipelines, and
        agents. Every piece here is something built out of curiosity.
      </p>
    </header>

    <div class="section-header">
      <h2>Builds</h2>
      <span class="count">{pieces.length} {pieces.length === 1 ? 'build' : 'builds'}</span>
    </div>
    <hr />

    <div class="list">
      {pieces.map((piece) => (
        <IndexEntry
          href={`/projects/${piece.slug}`}
          title={piece.title}
          dek={piece.dek}
          stats={piece.stats}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .projects-index {
    max-width: var(--content-width-wide);
    margin: 0 auto;
    padding: var(--space-8);
  }

  header {
    margin-bottom: var(--space-16);
    max-width: 42rem;
  }

  .kicker {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin-bottom: var(--space-4);
  }

  h1 {
    font-size: 3rem;
  }

  .intro {
    color: var(--ink-soft);
    font-size: var(--size-dek);
    margin-top: var(--space-4);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }
  .section-header h2 {
    font-size: 1.75rem;
  }
  .count {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
  }

  hr {
    border: none;
    border-top: 1px solid var(--ink);
    margin: 0;
  }
</style>
