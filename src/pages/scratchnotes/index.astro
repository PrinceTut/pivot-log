---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndexMasthead from '../../components/IndexMasthead.astro';
import { withBase } from '../../utils/url';
import type { ResearchMeta } from '../../types';

// Self-updating: every .astro file in this folder with a `meta` export is listed.
const modules = import.meta.glob<{ meta: ResearchMeta }>('./*.astro', { eager: true });
const notes = Object.entries(modules)
  .filter(([path]) => !path.endsWith('/index.astro'))
  .map(([, mod]) => mod.meta)
  .filter(Boolean)
  .sort((a, b) => b.date.localeCompare(a.date));

// Intro copy as approved in chat (restored; an earlier zip had overwritten it).
const intro = 'A place to write about things I find important and want to think through properly. Just my thoughts on things I come across, people I meet, and what I read and listen to.';
---

<BaseLayout title="Scratchnotes" description={intro} nav="dark">
  <IndexMasthead theme="dark" title="Scratchnotes" rows={[['SCRATCH', ''], ['', 'NOTES']]} intro={intro} count={notes.length} countLabel={notes.length === 1 ? 'Post' : 'Posts'} />

  <section class="cards" aria-label="Posts">
    {notes.map((note) => (
      <a class="card" href={withBase(`/scratchnotes/${note.slug}`)}>
        <span class="card__top">
          {(note.tags ?? []).map((t) => <span>[{t}]</span>)}
        </span>
        <span class="card__body">
          <span class="card__title">{note.title}</span>
          <span class="card__dek">{note.dek}</span>
        </span>
        <span class="card__foot"><span>{note.date}</span><span aria-hidden="true">Read &rarr;</span></span>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr));
    gap: var(--space-6);
    padding: var(--space-16) var(--gutter) 0;
    max-width: 1500px;
    margin: 0 auto;
  }
  .card {
    display: flex;
    flex-direction: column;
    border: 2px solid var(--black);
    background: var(--paper);
    color: var(--black);
    text-decoration: none;
  }
  .card:hover { background: var(--gold); }
  .card__top {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 10px 16px;
    background: var(--black);
    color: var(--gold);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .card__body { display: flex; flex-direction: column; gap: 14px; padding: 22px 16px 28px; flex: 1; }
  .card__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 3vw, 46px);
    line-height: 0.95;
    letter-spacing: var(--track-statement);
    text-transform: uppercase;
  }
  .card__dek { font-size: 1.0625rem; line-height: 1.5; }
  .card__foot {
    display: flex;
    justify-content: space-between;
    padding: 12px 16px;
    border-top: 2px solid var(--black);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  @media (prefers-reduced-motion: no-preference) { .card { transition: background-color var(--transition-fast); } }
  @media (max-width: 639px) { .cards { padding-top: var(--space-8); } }
</style>
