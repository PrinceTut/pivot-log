---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';
import Button from '../components/Button.astro';
import type { ResearchMeta } from '../types';

// Real data — same self-updating glob mechanism as the /projects and
// /scratchnotes index pages. Homepage teasers are never hand-written copy.
const projectModules = import.meta.glob<{ meta: ResearchMeta }>('./projects/*.astro', {
  eager: true,
});
const projects = Object.entries(projectModules)
  .filter(([path]) => !path.endsWith('/index.astro'))
  .map(([, mod]) => mod.meta)
  .filter(Boolean)
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 2);

const noteModules = import.meta.glob<{ meta: ResearchMeta }>('./scratchnotes/*.astro', {
  eager: true,
});
const notes = Object.entries(noteModules)
  .filter(([path]) => !path.endsWith('/index.astro'))
  .map(([, mod]) => mod.meta)
  .filter(Boolean)
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 1);

// Small project icons — each one abstracts that specific project's own
// real centerpiece rather than a generic symbol. The RAG piece's icon is
// a simplified version of its actual chunk × retrieval grid (same shape
// as the Matrix component on the piece itself), with its single most
// significant real result highlighted: Contextual chunking + Hybrid
// search, +5.14, the largest gain and the most statistically significant
// finding in the whole piece. Future projects get their own icon in the
// same visual language (small square grid, one emphasized cell,
// monochrome) derived from whatever their own real centerpiece is —
// until then they fall back to the plain dashed placeholder box.
const projectIcons: Record<string, { rows: number; cols: number; highlight: [number, number] }> = {
  'rag-chunking-and-retrieval': { rows: 5, cols: 4, highlight: [4, 0] },
};

function iconCells(icon: { rows: number; cols: number; highlight: [number, number] }) {
  const cellSize = 16;
  const gap = 4;
  const totalW = icon.cols * cellSize + (icon.cols - 1) * gap;
  const totalH = icon.rows * cellSize + (icon.rows - 1) * gap;
  const offsetX = (100 - totalW) / 2;
  const offsetY = (100 - totalH) / 2;
  const cells: { x: number; y: number; highlight: boolean }[] = [];
  for (let r = 0; r < icon.rows; r++) {
    for (let c = 0; c < icon.cols; c++) {
      cells.push({
        x: offsetX + c * (cellSize + gap),
        y: offsetY + r * (cellSize + gap),
        highlight: icon.highlight[0] === r && icon.highlight[1] === c,
      });
    }
  }
  return { cells, cellSize };
}
---

<BaseLayout
  title="Pivot Log"
  description="Independent research and writing on how systems actually behave."
>
  <div class="home">
    <section class="hero">
      <h1>Keeping up with the Frontier</h1>
      <p class="sub">Independent projects and write-ups breaking down the LLM space and its components.</p>
      <Button href={withBase('/projects')}>Explore the projects</Button>
    </section>

    <section class="statement" id="statement-section">
      <h2 class="statement-heading">A REPOSITORY OF ALL MY TECH PERSPECTIVES.</h2>
      <div class="statement-grid">
        <div class="statement-list">
          <div class="statement-row" data-row-index="0">
            <span class="num">01</span>
            <span class="statement-text draft-text">Most of what I build starts as scattered notes and half-formed questions.</span>
          </div>
          <div class="statement-row" data-row-index="1">
            <span class="num">02</span>
            <span class="statement-text draft-text">Patterns emerge once I start tracing how the pieces actually connect.</span>
          </div>
          <div class="statement-row" data-row-index="2">
            <span class="num">03</span>
            <span class="statement-text draft-text">What's left is a specific, testable claim — not a vibe.</span>
          </div>
        </div>
        <div class="statement-visual-pin">
          <div class="statement-visual" id="scroll-visual" data-active-state="0">
            <svg viewBox="0 0 400 300" class="graph-svg" aria-hidden="true">
              <!-- "Structure" edges — partial connections, de-emphasized once the
                   resolved path appears in state 2. Hand-placed, not generated,
                   for a deliberate composition rather than random scatter. -->
              <g class="graph-edge structure">
                <line x1="30" y1="60" x2="90" y2="40" />
                <line x1="90" y1="40" x2="160" y2="55" />
                <line x1="160" y1="55" x2="230" y2="40" />
                <line x1="230" y1="40" x2="300" y2="30" />
                <line x1="40" y1="140" x2="110" y2="260" />
                <line x1="200" y1="220" x2="280" y2="190" />
                <line x1="280" y1="190" x2="350" y2="220" />
                <line x1="110" y1="260" x2="200" y2="220" />
                <line x1="30" y1="60" x2="40" y2="140" />
                <line x1="170" y1="130" x2="200" y2="220" />
              </g>
              <!-- The resolved path — one clear route through the network,
                   full weight only in the final state. -->
              <g class="graph-edge path-edge">
                <line x1="55" y1="235" x2="120" y2="190" />
                <line x1="120" y1="190" x2="170" y2="130" />
                <line x1="170" y1="130" x2="245" y2="100" />
                <line x1="245" y1="100" x2="310" y2="65" />
                <line x1="310" y1="65" x2="355" y2="50" />
              </g>
              <!-- Context nodes -->
              <g class="graph-node context">
                <circle cx="30" cy="60" r="3" />
                <circle cx="90" cy="40" r="3" />
                <circle cx="160" cy="55" r="3" />
                <circle cx="230" cy="40" r="3" />
                <circle cx="300" cy="30" r="3" />
                <circle cx="370" cy="90" r="3" />
                <circle cx="40" cy="140" r="3" />
                <circle cx="110" cy="260" r="3" />
                <circle cx="200" cy="220" r="3" />
                <circle cx="280" cy="190" r="3" />
                <circle cx="350" cy="220" r="3" />
                <circle cx="200" cy="270" r="3" />
              </g>
              <!-- Path nodes — the resolved route -->
              <g class="graph-node path-node">
                <circle cx="55" cy="235" r="4" />
                <circle cx="120" cy="190" r="4" />
                <circle cx="170" cy="130" r="4" />
                <circle cx="245" cy="100" r="4" />
                <circle cx="310" cy="65" r="4" />
                <circle cx="355" cy="50" r="4" />
              </g>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <section class="teaser">
      <p class="kicker">Projects</p>
      <h2>My projects.</h2>
      <p class="teaser-intro">
        Exercises in building and breaking systems, to understand the
        mechanisms behind models, pipelines, and agents.
      </p>

      <div class="teaser-list">
        {projects.map((p, i) => {
          const icon = projectIcons[p.slug];
          const grid = icon ? iconCells(icon) : null;
          return (
            <a class="teaser-row" href={withBase(`/projects/${p.slug}`)}>
              <div class={`row-visual ${icon ? 'has-icon' : ''}`} data-reveal>
                {grid ? (
                  <svg viewBox="0 0 100 100" class="icon-svg" aria-hidden="true">
                    {grid.cells.map((cell) => (
                      <rect
                        x={cell.x}
                        y={cell.y}
                        width={grid.cellSize}
                        height={grid.cellSize}
                        class={`icon-cell ${cell.highlight ? 'highlight' : ''}`}
                      />
                    ))}
                  </svg>
                ) : (
                  <>Illustration<br />placeholder</>
                )}
              </div>
              <span class="row-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="row-body">
                <span class="row-title">{p.title}</span>
                <span class="row-dek">{p.dek}</span>
              </span>
              {p.stats && p.stats.length > 0 && (
                <span class="row-stat">
                  <span class="row-stat-value">{p.stats[p.stats.length - 1].value}</span>
                  <span class="row-stat-label">{p.stats[p.stats.length - 1].label}</span>
                </span>
              )}
            </a>
          );
        })}
      </div>

      <Button href={withBase('/projects')}>Explore the projects</Button>
    </section>

    <section class="teaser">
      <p class="kicker">Scratchnotes</p>
      <h2>Scratchnotes.</h2>
      <p class="teaser-intro">
        A place to write about things I find important — faster and
        looser than a full project.
      </p>

      <div class="notes-card-wrap">
        {notes.map((n) => (
          <a class="notes-card" href={withBase(`/scratchnotes/${n.slug}`)}>
            <span class="notes-card-title">{n.title}</span>
            <span class="notes-card-dek">{n.dek}</span>
            <span class="notes-card-meta">{n.date} &middot; &rarr;</span>
          </a>
        ))}
      </div>

      <Button href={withBase('/scratchnotes')}>Read Scratchnotes</Button>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    width: 100%;
  }

  /* --- Hero: centered, full-bleed padding --- */
  .hero {
    padding: var(--space-24) var(--space-16) var(--space-16);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero h1 {
    font-family: var(--font-sans);
    font-size: 4.5rem;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--ink);
    max-width: 50rem;
    margin-bottom: var(--space-6);
  }
  .sub {
    font-family: var(--font-serif);
    font-size: var(--size-dek);
    color: var(--ink-soft);
    max-width: 34rem;
    margin-bottom: var(--space-8);
  }

  /* --- Statement section: full-bleed, huge type, scroll-linked visual --- */
  .statement {
    padding: var(--space-24) var(--space-16);
    border-top: var(--border);
  }

  .statement-heading {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 5.5rem;
    line-height: 1.02;
    letter-spacing: -0.01em;
    max-width: 64rem;
    margin: 0 0 var(--space-16) 0;
  }

  .statement-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-16);
    align-items: start;
  }

  .statement-list {
    border-top: var(--border);
  }
  .statement-row {
    display: flex;
    gap: var(--space-8);
    align-items: center;
    min-height: 40vh;
    padding: var(--space-6) 0;
    border-bottom: var(--border);
  }
  .statement-row .num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-soft);
    min-width: 2rem;
  }
  .statement-text {
    font-family: var(--font-serif);
    font-size: 1.25rem;
  }
  .draft-text {
    color: var(--ink-soft);
    font-style: italic;
  }

  .statement-visual-pin {
    position: sticky;
    top: 130px;
  }
  .statement-visual {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--paper-2);
    border: var(--border);
  }
  .graph-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .graph-node circle {
    fill: var(--ink-soft);
  }
  .graph-edge line {
    stroke: var(--ink-soft);
    stroke-width: 1;
    fill: none;
  }
  .graph-edge.path-edge line {
    stroke: var(--ink);
  }

  .graph-node,
  .graph-edge {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .graph-node,
    .graph-edge,
    .graph-node circle,
    .graph-edge line {
      transition: opacity var(--transition-reveal), stroke-width var(--transition-reveal),
        r var(--transition-reveal), fill var(--transition-reveal);
    }
  }

  /* State 0 — sparse: faint, disconnected nodes, no edges at all. */
  .statement-visual[data-active-state="0"] .graph-node {
    opacity: 0.45;
  }
  .statement-visual[data-active-state="0"] .graph-edge {
    opacity: 0;
  }

  /* State 1 — structure emerges: partial connections, nodes settle in. */
  .statement-visual[data-active-state="1"] .graph-node {
    opacity: 0.75;
  }
  .statement-visual[data-active-state="1"] .graph-edge.structure {
    opacity: 0.5;
  }
  .statement-visual[data-active-state="1"] .graph-edge.path-edge {
    opacity: 0;
  }

  /* State 2 — resolved: one clear route stands out, everything else recedes. */
  .statement-visual[data-active-state="2"] .graph-node.context {
    opacity: 0.25;
  }
  .statement-visual[data-active-state="2"] .graph-node.path-node {
    opacity: 1;
  }
  .statement-visual[data-active-state="2"] .graph-node.path-node circle {
    fill: var(--ink);
    r: 5;
  }
  .statement-visual[data-active-state="2"] .graph-edge.structure {
    opacity: 0.12;
  }
  .statement-visual[data-active-state="2"] .graph-edge.path-edge {
    opacity: 1;
  }
  .statement-visual[data-active-state="2"] .graph-edge.path-edge line {
    stroke-width: 2;
  }

  @media (max-width: 899px) {
    .statement-grid {
      grid-template-columns: 1fr;
    }
    .statement-visual-pin {
      display: none;
    }
    .statement-row {
      min-height: 0;
    }
  }

  /* --- Teaser sections (Projects / Scratchnotes) --- */
  .teaser {
    padding: var(--space-24) var(--space-16);
    border-top: var(--border);
  }
  .kicker {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin-bottom: var(--space-3);
  }
  .teaser h2 {
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: -0.01em;
    font-size: 3.5rem;
    margin-bottom: var(--space-4);
  }
  .teaser-intro {
    font-family: var(--font-serif);
    font-size: var(--size-dek);
    color: var(--ink-soft);
    max-width: 40rem;
    margin-bottom: var(--space-12);
  }

  .teaser-list {
    max-width: 64rem;
    border-top: var(--border);
    margin-bottom: var(--space-8);
  }
  .teaser-row {
    display: grid;
    grid-template-columns: 6rem 3rem 1fr auto;
    gap: var(--space-8);
    align-items: center;
    padding: var(--space-8) 0;
    border-bottom: var(--border);
    text-decoration: none;
    color: inherit;
  }
  .row-visual {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: var(--paper-2);
    border: 1px dashed var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.5625rem;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1.4;
    padding: var(--space-1);
    opacity: 0;
    transform: translateY(16px);
  }
  /* Once a project has a real icon (see projectIcons below), it gets the
     site's normal solid hairline border instead of the dashed
     "placeholder" look — projects without one yet keep the dashed box
     until their own icon exists. */
  .row-visual.has-icon {
    border: var(--border);
    padding: var(--space-3);
  }
  .icon-svg {
    width: 100%;
    height: 100%;
  }
  .icon-cell {
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 1.5;
  }
  .icon-cell.highlight {
    fill: var(--ink);
    stroke: var(--ink);
  }
  .row-visual.is-visible {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .row-visual {
      transition: opacity var(--transition-reveal), transform var(--transition-reveal);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .row-visual {
      opacity: 1;
      transform: none;
    }
  }
  .row-num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }
  .row-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .row-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
  }
  .teaser-row:hover .row-title {
    text-decoration-color: var(--ink);
  }
  .row-dek {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--ink-soft);
    max-width: 34rem;
  }
  .row-stat {
    text-align: right;
    white-space: nowrap;
  }
  .row-stat-value {
    display: block;
    font-family: var(--font-sans);
    font-size: 2rem;
    font-weight: 600;
    color: var(--ink);
  }
  .row-stat-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--ink-soft);
    max-width: 10rem;
  }

  .notes-card-wrap {
    max-width: 36rem;
    margin-bottom: var(--space-8);
  }
  .notes-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6) 0;
    border-top: var(--border);
    border-bottom: var(--border);
    text-decoration: none;
    color: inherit;
  }
  .notes-card-title {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--ink);
  }
  .notes-card-dek {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
  .notes-card-meta {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  @media (max-width: 639px) {
    .hero, .statement, .teaser {
      padding-left: var(--space-4);
      padding-right: var(--space-4);
    }
    .hero h1, .statement-heading, .teaser h2 {
      font-size: 2.25rem;
    }
    .teaser-row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .row-visual {
      display: none;
    }
    .row-stat {
      text-align: left;
    }
  }
</style>

<script>
  // The pinned visual panel's stick-while-scrolling behavior is handled
  // natively by CSS `position: sticky` — no JS needed for that part.
  // This script's only job is tracking which numbered row is currently
  // near the vertical center of the viewport, and crossfading the
  // matching placeholder label into view (real illustrations will swap
  // in here once they exist, same mechanism).
  function setupStatementScroll() {
    const rows = document.querySelectorAll<HTMLElement>('.statement-row[data-row-index]');
    const visual = document.getElementById('scroll-visual');
    if (!rows.length || !visual) return;

    // Note: unlike some other scroll effects on this site, this one still
    // runs under prefers-reduced-motion — the graph's state is meaningful
    // content (which row you're reading), not decorative motion. The CSS
    // above already strips the smooth transition in that case, so the
    // state still snaps correctly as you scroll, it just doesn't animate.
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const index = entry.target.getAttribute('data-row-index');
          if (index !== null) visual.setAttribute('data-active-state', index);
        });
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
    );

    rows.forEach((row) => observer.observe(row));
  }

  document.addEventListener('astro:page-load', setupStatementScroll);

  // Per-project illustration placeholders on the homepage teaser: a
  // simple trigger-once fade-in as each row scrolls into view (not a
  // continuous crossfade like the statement section above — these are
  // independent list items, not one shared narrative panel, so each
  // just needs to appear once and stay).
  function setupProjectVisualReveal() {
    const visuals = document.querySelectorAll<HTMLElement>('.row-visual[data-reveal]');
    if (!visuals.length) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );

    visuals.forEach((visual) => observer.observe(visual));
  }

  document.addEventListener('astro:page-load', setupProjectVisualReveal);
</script>
