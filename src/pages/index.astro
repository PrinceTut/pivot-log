---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPill from '../components/GlassPill.astro';
import StarBadge from '../components/StarBadge.astro';
import { withBase } from '../utils/url';
import { REPO_URL } from '../config';

// Statements exactly as written in the Figma file (TEXT nodes 31:17, 31:20, 31:23).
const statements = [
  'Most of what I build starts as scattered notes and half-formed questions.',
  'Patterns emerge once I start tracing how the pieces actually connect.',
  "What's left is a specific, testable claim; not a vibe.",
];

// Network graph for the grey slot (the previously approved sparse -> structure -> resolved
// visual), re-projected from its old 400x300 space onto the slot's 1119x567 proportions.
const X = (x: number) => 60 + x * 2.6;
const Y = (y: number) => 30 + y * 1.7;
const structureEdges = [[30,60,90,40],[90,40,160,55],[160,55,230,40],[230,40,300,30],[40,140,110,260],
  [200,220,280,190],[280,190,350,220],[110,260,200,220],[30,60,40,140],[170,130,200,220]];
const pathPoints = [[55,235],[120,190],[170,130],[245,100],[310,65],[355,50]];
const contextNodes = [[30,60],[90,40],[160,55],[230,40],[300,30],[370,90],[40,140],[110,260],[200,220],[280,190],[350,220],[200,270]];
const pathEdges = pathPoints.slice(1).map((p, i) => [...pathPoints[i], ...p]);

const heroSub = 'Independent projects and write-ups breaking down the LLM space and its components';
---

<BaseLayout title="Pivot Log" description="Independent projects and write-ups breaking down the LLM space and its components." nav={false}>
  <!-- HERO: Figma frame 31:3, rectangle 1920x1171 #f2cd53 -->
  <div class="cq">
   <div class="hero-track" id="hero-track">
    <section class="hero" id="hero" aria-labelledby="hero-title">
      <h1 id="hero-title" class="sr-only">Keeping up with the Frontier</h1>

      <div class="hero__words" aria-hidden="true">
        <span class="w rv" style="--x:21; --y:37; --a:.08; --b:.22">KEEPING</span>
        <span class="w w--r rv" style="--y:37; --a:.14; --b:.28">UP</span>
        <span class="w rv" style="--x:21; --y:320; --a:.20; --b:.34">WI</span>
        <span class="w w--r rv" style="--y:320; --a:.26; --b:.40">TH</span>
        <span class="w rv" style="--x:21; --y:603; --a:.32; --b:.46">TH</span>
        <span class="w w--r rv" style="--y:603; --a:.38; --b:.52">E</span>
        <span class="w rv" style="--x:21; --y:886; --a:.44; --b:.58">FRONTIER</span>
      </div>
      <p class="hero__mobile-title" aria-hidden="true">Keeping up with the frontier</p>

      <img class="hero__logo rv-logo" style="--a:.02; --b:.30" src={withBase('/logo.webp')} alt="Pivot Log" width="515" height="370" fetchpriority="high" />
      <div class="hero__rule rv" style="--a:.56; --b:.66"></div>
      <p class="hero__sub rv" style="--a:.60; --b:.72">{heroSub}<span class="cursor" aria-hidden="true">|</span></p>

      <nav class="hero__pills rv" style="--a:.66; --b:.78" aria-label="Main">
        <GlassPill href={withBase('/projects')} label="Projects" size="lg" />
        <GlassPill href={withBase('/scratchnotes')} label="Scratchnotes" size="lg" />
        <GlassPill href={REPO_URL} label="Git Repo" size="lg" external />
      </nav>

      <div class="hero__star-wrap rv" style="--a:.70; --b:.82"><StarBadge class="hero__star" /></div>
      <p class="hero__cue rv-cue" style="--a:0; --b:.08" aria-hidden="true">Scroll <span>&darr;</span></p>
    </section>
   </div>
  </div>

  <!-- SLOT: Figma "Rectangle 7" 1119x567 #d9d9d9 (placeholder), filled with the network graph -->
  <div class="cq">
   <div class="story-track" id="story-track">
    <div class="story" id="story">
    <section class="slot" aria-label="From scattered notes to a testable claim">
      <figure class="slab" id="slab" data-state="2">
        <svg class="graph" viewBox="0 0 1119 567" aria-hidden="true">
          <g class="g-structure">{structureEdges.map(([a,b,c,d]) => <line x1={X(a)} y1={Y(b)} x2={X(c)} y2={Y(d)} />)}</g>
          <g class="g-path">{pathEdges.map(([a,b,c,d]) => <line x1={X(a)} y1={Y(b)} x2={X(c)} y2={Y(d)} />)}</g>
          <g class="g-context">{contextNodes.map(([a,b]) => <circle cx={X(a)} cy={Y(b)} r="7" />)}</g>
          <g class="g-pathnodes">{pathPoints.map(([a,b]) => <circle cx={X(a)} cy={Y(b)} r="9" />)}</g>
        </svg>
        <figcaption class="slab__labels">
          <span class="lbl lbl--a">01 Notes</span>
          <span class="lbl lbl--b">02 Structure</span>
          <span class="lbl lbl--c">03 Claim</span>
        </figcaption>
      </figure>
    </section>

    <!-- STATEMENT: Figma text node at (55,1814), 128px, with redaction bars and the prism -->
    <section class="st" aria-labelledby="st-title">
      <h2 id="st-title" class="sr-only">A repository of all my tech perspectives</h2>

      <div class="st__desk" aria-hidden="true">
        <span class="sw" style="--x:55; --y:0">A</span>
        <span class="bar" style="--x:171; --y:22; --w:687; --h:90"></span>
        <span class="sw sw--r" style="--r:290; --y:0">REPOSITORY</span>
        <StarBadge fill="white" class="st__star" />
        <span class="sw sw--r" style="--r:78; --y:0">F</span>
        <span class="bar" style="--x:1659; --y:130; --w:182; --h:138"></span>
        <span class="sw" style="--x:55; --y:264">ALL MY</span>
        <span class="bar" style="--x:512; --y:286; --w:234; --h:90"></span>
        <span class="sw sw--r" style="--r:826; --y:264">TECH</span>
        <span class="bar" style="--x:1108; --y:286; --w:466; --h:90"></span>
        <span class="sw" style="--x:55; --y:396">PERSPECTIVES</span>
        <span class="bar" style="--x:1176; --y:414; --w:313; --h:90"></span>
      </div>

      <div class="prism-stage">
        <ul class="prism" id="prism">
          {statements.map((s, i) => <li class="face" style={`--i:${i}`}>{s}</li>)}
        </ul>
      </div>

      <p class="st__mono">Independent research and writing on how systems actually behave.</p>

      <nav class="st__pills" aria-label="Explore">
        <GlassPill href={REPO_URL} label="Git Repo" size="lg" external />
        <GlassPill href={withBase('/projects')} label="Projects" size="lg" />
        <GlassPill href={withBase('/scratchnotes')} label="Scratchnotes" size="lg" />
      </nav>

      <!-- Mobile composition (below 900px): same content, reflowed -->
      <p class="st__mobile" aria-hidden="true">A <span class="ibar" style="--w:2.4em"></span> Repository of all my <span class="ibar" style="--w:1.2em"></span> tech <span class="ibar" style="--w:1.8em"></span> perspectives</p>
    </section>
    </div>
   </div>
  </div>
</BaseLayout>

<style>
  /* ---------------- HERO ---------------- */
  /* Scale = smaller of width/1920 and screen-height/1171, so the pinned poster always fits. */
  .cq > .hero-track { --u: min(calc(100cqw / 1920), calc(100svh / 1171)); background: var(--gold); }
  .hero {
    --p: 1;
    position: relative;
    width: calc(1920 * var(--u));
    height: calc(1171 * var(--u));
    margin: 0 auto;
    background: var(--gold);
    overflow: hidden;
  }
  .hero-track.is-pinned { height: calc(1171 * var(--u) + 150svh); }
  .hero-track.is-pinned .hero { position: sticky; top: max(0px, calc((100svh - 1171 * var(--u)) / 2)); }
  /* Keyboard users tabbing into the hero see it fully revealed at once */
  .hero:focus-within { --p: 1 !important; }

  /* Reveal: --t runs 0 -> 1 as scroll progress --p moves through this element's [--a, --b] window */
  .rv, .rv-logo, .rv-cue { --t: clamp(0, calc((var(--p) - var(--a)) / (var(--b) - var(--a))), 1); }
  .rv { opacity: var(--t); translate: 0 calc((1 - var(--t)) * 30 * var(--u)); }
  .rv-logo { translate: 0 calc((1 - var(--t)) * 118 * var(--u)); }   /* starts dead centre, settles to its Figma spot */
  .rv-cue { opacity: calc(1 - var(--t)); }
  .hero-track.is-pinned .hero:not(.is-revealed) .hero__pills { pointer-events: none; }

  .hero__cue {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(1060 * var(--u));
    margin: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: max(12px, calc(18 * var(--u)));
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero-track:not(.is-pinned) .hero__cue { display: none; }
  .hero__cue span { display: inline-block; }
  @media (prefers-reduced-motion: no-preference) {
    .hero__cue span { animation: cue-nudge 1.4s ease-in-out infinite; }
  }
  @keyframes cue-nudge { 50% { translate: 0 0.3em; } }
  .w {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc(300 * var(--u));
    line-height: calc(242 * var(--u));
    letter-spacing: var(--track-display);
    white-space: nowrap;
  }
  .w--r { left: auto; right: calc(54 * var(--u)); }
  .hero__mobile-title { display: none; }
  .hero__logo {
    position: absolute;
    left: calc(703 * var(--u));
    top: calc(282 * var(--u));
    width: calc(515 * var(--u));
    height: auto;
  }
  .hero__rule {
    position: absolute;
    left: calc(649 * var(--u));
    top: calc(632 * var(--u));
    width: calc(622 * var(--u));
    height: calc(6 * var(--u));
    background: var(--black);
  }
  .hero__sub {
    position: absolute;
    left: calc(549 * var(--u));
    top: calc(654 * var(--u));
    width: calc(822 * var(--u));
    margin: 0;
    font-family: var(--font-pixel);
    font-size: calc(47 * var(--u));
    line-height: calc(37 * var(--u));
    letter-spacing: -0.042em;
    text-align: justify;
    text-align-last: left;
  }
  .hero__pills {
    position: absolute;
    left: calc(556 * var(--u));
    top: calc(794 * var(--u));
    display: flex;
    gap: calc(30 * var(--u));
  }
  .hero__star-wrap {
    position: absolute;
    left: calc(1637 * var(--u));
    top: calc(888 * var(--u));
    width: calc(242 * var(--u));
    height: calc(242 * var(--u));
  }
  .hero__star-wrap :global(.hero__star) { width: 100%; height: 100%; }

  /* ---------------- STORY (graph + statement, pinned together) ---------------- */
  .cq > .story-track { --u: min(calc(100cqw / 1920), calc(100svh / 1215)); }
  .story { width: calc(1920 * var(--u)); margin: 0 auto; }
  .story-track.is-pinned { height: calc(1215 * var(--u) + 200svh); }
  .story-track.is-pinned .story { position: sticky; top: max(0px, calc((100svh - 1215 * var(--u)) / 2)); }

  /* ---------------- SLOT (graph) ---------------- */
  .slot { padding: calc(43 * var(--u)) 0 0 calc(36 * var(--u)); }
  .slab {
    position: relative;
    margin: 0;
    width: calc(1119 * var(--u));
    height: calc(567 * var(--u));
    background: var(--slab);
  }
  .graph { width: 100%; height: 100%; display: block; }
  .graph line { stroke: var(--black); fill: none; }
  .g-structure line { stroke-width: 2; }
  .g-path line { stroke-width: 5; }
  .graph circle { fill: var(--black); }
  .slab__labels {
    position: absolute;
    left: calc(28 * var(--u));
    bottom: calc(22 * var(--u));
    display: flex;
    gap: calc(28 * var(--u));
    margin: 0;
    font-family: var(--font-mono);
    font-style: normal;
    font-weight: 700;
    font-size: max(11px, calc(17 * var(--u)));
    text-transform: uppercase;
    color: var(--black);
  }
  .lbl { opacity: 0.35; }

  /* Graph states follow the prism: data-state 0/1/2 is set from scroll progress (default 2 = resolved) */
  .g-structure, .g-path, .g-context, .g-pathnodes, .lbl { transition: opacity 0.45s ease; }
  .slab[data-state="0"] .g-structure { opacity: 0; }
  .slab[data-state="0"] .g-path { opacity: 0; }
  .slab[data-state="0"] .g-context, .slab[data-state="0"] .g-pathnodes { opacity: 0.45; }
  .slab[data-state="1"] .g-structure { opacity: 0.55; }
  .slab[data-state="1"] .g-path { opacity: 0; }
  .slab[data-state="1"] .g-context, .slab[data-state="1"] .g-pathnodes { opacity: 0.8; }
  .slab[data-state="2"] .g-structure { opacity: 0.15; }
  .slab[data-state="2"] .g-path { opacity: 1; }
  .slab[data-state="2"] .g-context { opacity: 0.3; }
  .slab[data-state="2"] .g-pathnodes { opacity: 1; }
  .slab[data-state="0"] .lbl--a, .slab[data-state="1"] .lbl--b, .slab[data-state="2"] .lbl--c { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .g-structure, .g-path, .g-context, .g-pathnodes, .lbl { transition: none; }
  }

  /* ---------------- STATEMENT ---------------- */
  .st {
    position: relative;
    height: calc(560 * var(--u));
    margin-top: calc(33 * var(--u));
  }
  .sw, .bar {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
  }
  .sw {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc(128 * var(--u));
    line-height: calc(132 * var(--u));
    letter-spacing: var(--track-statement);
    white-space: nowrap;
  }
  .sw--r { left: auto; right: calc(var(--r) * var(--u)); }
  .bar {
    width: calc(var(--w) * var(--u));
    height: calc(var(--h) * var(--u));
    background: var(--black);
  }
  .st :global(.st__star) {
    position: absolute;
    left: calc(1686 * var(--u));
    top: calc(22 * var(--u));
    width: calc(90 * var(--u));
    height: calc(90 * var(--u));
  }

  /* Prism: three panels on a vertical axis at x=805, one turn per 7.92s (GIF: 396 frames x 20ms) */
  .prism-stage {
    position: absolute;
    left: calc(680 * var(--u));
    top: calc(128 * var(--u));
    width: calc(400 * var(--u));
    height: calc(114 * var(--u));
    perspective: calc(2400 * var(--u));
  }
  .prism {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    transform-style: preserve-3d;
    transform: translateZ(calc(-600 * var(--u))) rotateY(var(--spin, 0deg));
  }
  .face {
    position: absolute;
    inset: 0;
    transform: rotateY(calc(var(--i) * 120deg)) translateZ(calc(600 * var(--u)));
    font-family: var(--font-display);
    font-weight: 500;
    font-size: calc(26 * var(--u));
    line-height: calc(36 * var(--u));
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-align: justify;
    text-align-last: left;
  }

  .st__mono {
    position: absolute;
    left: calc(961 * var(--u));
    top: calc(413 * var(--u));
    width: calc(194 * var(--u));
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: calc(17 * var(--u));
    line-height: calc(24 * var(--u));
    letter-spacing: -0.04em;
    text-align: justify;
    text-align-last: left;
  }
  .st__pills {
    position: absolute;
    right: calc(79 * var(--u));
    top: calc(305 * var(--u));
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: calc(10 * var(--u));
  }
  .st__mobile { display: none; }

  /* ---------------- MOBILE (below 900px): reflow instead of shrinking the poster ---------------- */
  @media (max-width: 899px) and (prefers-reduced-motion: no-preference) {
    .hero__mobile-title, .hero__logo, .hero__rule, .hero__sub, .hero__pills, .hero__star-wrap {
      animation: load-in 0.7s ease both;
    }
    .hero__logo { animation-delay: 0s; }
    .hero__mobile-title { animation-delay: 0.15s; }
    .hero__rule { animation-delay: 0.3s; }
    .hero__sub { animation-delay: 0.4s; }
    .hero__pills { animation-delay: 0.5s; }
    .hero__star-wrap { animation-delay: 0.6s; }
  }
  @keyframes load-in { from { opacity: 0; translate: 0 14px; } }
  @media (max-width: 899px) {
    .hero { height: auto; padding: 28px var(--gutter) 40px; }
    .hero__words { display: none; }
    .hero__mobile-title {
      display: block;
      margin: 0 0 20px;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 17vw;
      line-height: 0.84;
      letter-spacing: var(--track-display);
      text-transform: uppercase;
    }
    .hero__logo, .hero__rule, .hero__sub, .hero__pills { position: static; }
    .hero__logo { width: min(62%, 320px); display: block; margin: 0 auto; }
    .hero__rule { width: min(84%, 460px); height: 5px; margin: 6px auto 12px; }
    .hero__sub { width: auto; font-size: 22px; line-height: 20px; }
    .hero__pills { flex-wrap: wrap; gap: 8px; margin-top: 18px; }
    .hero__pills :global(.pill--lg) { --h: 40px; }
    .hero { width: auto; }
    .story { width: auto; }
    .hero__star-wrap { position: static; width: 64px; height: 64px; margin: 18px 0 0 auto; }
    .hero__mobile-title, .hero__logo, .hero__rule, .hero__sub, .hero__pills, .hero__star-wrap { translate: none; }

    .slot { padding: 20px var(--gutter) 0; }
    .slab { width: 100%; height: auto; aspect-ratio: 1119 / 567; }
    .slab__labels { font-size: 10px; gap: 12px; left: 10px; bottom: 8px; }

    .st { height: auto; margin-top: 0; padding: 32px var(--gutter) 8px; display: flex; flex-direction: column; }
    .st__mobile { order: -1; }
    .st__desk, .st :global(.st__star) { display: none; }
    .st__mobile {
      display: block;
      margin: 0 0 24px;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 11vw;
      line-height: 0.98;
      letter-spacing: var(--track-statement);
      text-transform: uppercase;
    }
    .ibar { display: inline-block; width: var(--w); height: 0.7em; background: var(--black); vertical-align: -0.02em; }
    .prism-stage { position: static; width: auto; height: auto; perspective: none; }
    .prism { display: grid; gap: 12px; transform: none; animation: none; }
    .face { position: static; transform: none; font-size: 17px; line-height: 23px; padding: 12px 0; border-top: 2px solid var(--black); }
    .st__mono { position: static; width: auto; font-size: 14px; line-height: 20px; margin: 20px 0; }
    .st__pills { position: static; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 8px; }
    .st__pills :global(.pill--lg) { --h: 40px; }
  }
</style>

<script>
  // Two pinned scroll sequences on desktop (>= 900px, motion allowed):
  //  1. Hero: only the logo at first; words, then subtitle/pills/badge reveal with scroll.
  //  2. Story: the prism turns one statement per scroll stretch; the graph state follows.
  // Without JS, on phones, or with reduced motion, nothing pins and everything shows.
  let cleanup: (() => void) | null = null;

  const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
  const smooth = (t: number) => t * t * (3 - 2 * t);

  // Progress 0..1 through a pinned track: 0 when it reaches the top, 1 when it's about to release.
  function progress(track: HTMLElement) {
    const r = track.getBoundingClientRect();
    return clamp01(-r.top / Math.max(1, r.height - window.innerHeight));
  }

  // Prism position in "faces": hold on 0, turn to 1, hold, turn to 2, hold.
  function faceAt(p: number) {
    if (p < 0.2) return 0;
    if (p < 0.4) return smooth((p - 0.2) / 0.2);
    if (p < 0.6) return 1;
    if (p < 0.8) return 1 + smooth((p - 0.6) / 0.2);
    return 2;
  }

  function setup() {
    cleanup?.();
    cleanup = null;
    const heroTrack = document.getElementById('hero-track');
    const hero = document.getElementById('hero');
    const storyTrack = document.getElementById('story-track');
    const prism = document.getElementById('prism');
    const slab = document.getElementById('slab');
    if (!heroTrack || !hero || !storyTrack || !prism || !slab) return;

    const canPin = window.matchMedia('(min-width: 900px) and (prefers-reduced-motion: no-preference)');
    let ticking = false;

    const render = () => {
      ticking = false;
      if (!canPin.matches) return;
      const hp = progress(heroTrack);
      hero.style.setProperty('--p', hp.toFixed(4));
      hero.classList.toggle('is-revealed', hp >= 0.7);
      const f = faceAt(progress(storyTrack));
      prism.style.setProperty('--spin', `${(-120 * f).toFixed(2)}deg`);
      slab.dataset.state = String(Math.round(f));
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(render); } };
    const apply = () => {
      const on = canPin.matches;
      heroTrack.classList.toggle('is-pinned', on);
      storyTrack.classList.toggle('is-pinned', on);
      if (on) render();
      else {
        hero.style.removeProperty('--p');
        prism.style.removeProperty('--spin');
        slab.dataset.state = '2';
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    canPin.addEventListener('change', apply);
    apply();
    cleanup = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
      canPin.removeEventListener('change', apply);
    };
  }

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = null; });
</script>
