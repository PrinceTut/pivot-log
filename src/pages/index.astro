---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPill from '../components/GlassPill.astro';
import StarBadge from '../components/StarBadge.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/url';
import { REPO_URL } from '../config';
import { FRAMES, LOGO_SURFER } from '../scripts/landing-frames';

const statements = [
  'Most of what I build starts as scattered notes and half-formed questions.',
  'Patterns emerge once I start tracing how the pieces actually connect.',
  "What's left is a specific, testable claim; not a vibe.",
];
const heroSub = 'Independent projects and write-ups breaking down the LLM space and its components';
const surferSlot = `left:${LOGO_SURFER.left * 100}%; top:${LOGO_SURFER.top * 100}%; width:${LOGO_SURFER.width * 100}%;`;
---

<BaseLayout title="Pivot Log" description="Independent projects and write-ups breaking down the LLM space and its components." nav={false} footer={false}>
  <div class="stage" id="stage" data-base={withBase('/')}>

    <div class="finale" id="finale">
      <div class="finale__main">
        <section class="st" aria-labelledby="st-title">
          <h2 id="st-title" class="sr-only">A repository of all my tech perspectives</h2>
          <div class="st__desk" aria-hidden="true">
            <span class="sw rv" style="--x:55; --y:0; --a:.00; --b:.10">A</span>
            <span class="bar rv" style="--x:171; --y:22; --w:687; --h:90; --a:.05; --b:.15"></span>
            <span class="sw sw--r rv" style="--r:290; --y:0; --a:.10; --b:.20">REPOSITORY</span>
            <span class="st__star-wrap rv" style="--a:.16; --b:.26"><StarBadge fill="white" class="st__star" /></span>
            <span class="sw sw--r rv" style="--r:78; --y:0; --a:.16; --b:.26">F</span>
            <span class="bar rv" style="--x:1659; --y:130; --w:182; --h:138; --a:.22; --b:.32"></span>
            <span class="sw rv" style="--x:55; --y:264; --a:.34; --b:.44">ALL MY</span>
            <span class="bar rv" style="--x:512; --y:286; --w:234; --h:90; --a:.40; --b:.50"></span>
            <span class="sw sw--r rv" style="--r:826; --y:264; --a:.44; --b:.54">TECH</span>
            <span class="bar rv" style="--x:1108; --y:286; --w:466; --h:90; --a:.50; --b:.60"></span>
            <span class="bar rv" style="--x:60; --y:414; --w:202; --h:90; --a:.54; --b:.64"></span>
            <span class="sw rv" style="--x:291; --y:396; --a:.58; --b:.68">PERSPECTIVES</span>
          </div>
          <div class="prism-stage rv" style="--a:.28; --b:.40">
            <ul class="prism" id="prism">
              {statements.map((s, i) => <li class="face" style={`--i:${i}`}>{s}</li>)}
            </ul>
          </div>
          <nav class="st__pills rv" style="--a:.66; --b:.78" aria-label="Explore">
            <GlassPill href={REPO_URL} label="Git Repo" size="lg" external />
            <GlassPill href={withBase('/projects')} label="Projects" size="lg" />
            <GlassPill href={withBase('/scratchnotes')} label="Scratchnotes" size="lg" />
          </nav>
          <p class="st__mobile" aria-hidden="true">A <span class="ibar" style="--w:2.4em"></span> Repository of all my <span class="ibar" style="--w:1.2em"></span> tech <span class="ibar" style="--w:1.8em"></span> <span class="ibar" style="--w:1em"></span> perspectives</p>
        </section>
      </div>
      <div class="foot-wrap rv" style="--a:.78; --b:.92">
        <Footer variant="landing" />
        <img class="foot-surfer" id="foot-surfer" src={withBase('/surfer/f00.webp')} alt="" aria-hidden="true" width="1400" height="1404" loading="lazy" />
      </div>
    </div>

    <div class="layer-hero">
      <section class="hero" id="hero" aria-labelledby="hero-title">
        <h1 id="hero-title" class="sr-only">Keeping up with the Frontier</h1>
        <div class="hero__words" aria-hidden="true">
          <span class="w rv" style="--x:21; --y:37; --a:.08; --b:.22">KEEPING</span>
          <span class="w w--r rv" style="--y:37; --a:.14; --b:.28">UP</span>
          <span class="w rv" style="--x:21; --y:320; --a:.20; --b:.34">WI</span>
          <span class="w w--r rv" style="--y:320; --a:.26; --b:.40">TH</span>
          <span class="w rv" style="--x:21; --y:603; --a:.32; --b:.46">TH</span>
          <span class="w w--r rv" style="--y:603; --a:.38; --b:.52">E</span>
          <span class="w rv" style="--x:21; --y:886; --a:.44; --b:.58">FRONTIER</span>
        </div>
        <p class="hero__mobile-title" aria-hidden="true">Keeping up with the frontier</p>
        <div class="hero__logo rv-logo" style="--a:.02; --b:.30">
          <img class="hero__logo-type" src={withBase('/logo-type.webp')} alt="Pivot Log" width="515" height="370" fetchpriority="high" />
          <img class="hero__logo-surfer" src={withBase('/surfer/f00.webp')} alt="" aria-hidden="true" style={surferSlot} width="1400" height="1404" fetchpriority="high" />
        </div>
        <div class="hero__rule rv" style="--a:.56; --b:.66"></div>
        <p class="hero__sub rv" style="--a:.60; --b:.72">{heroSub}<span class="cursor" aria-hidden="true">|</span></p>
        <nav class="hero__pills rv" style="--a:.66; --b:.78" aria-label="Main">
          <GlassPill href={withBase('/projects')} label="Projects" size="lg" />
          <GlassPill href={withBase('/scratchnotes')} label="Scratchnotes" size="lg" />
          <GlassPill href={REPO_URL} label="Git Repo" size="lg" external />
        </nav>
        <div class="hero__star-wrap rv" style="--a:.70; --b:.82"><StarBadge class="hero__star" /></div>
        <p class="hero__cue rv-cue" style="--a:0; --b:.08" aria-hidden="true">Scroll <span>&darr;</span></p>
      </section>
    </div>

    <div class="halves" id="halves"></div>

    <svg class="fx" id="fx" aria-hidden="true" preserveAspectRatio="none">
      <path id="fx-trail-ink" class="trail-ink" d="" />
      <path id="fx-trail" class="trail" d="" />
      <g id="fx-speed" class="speed"></g>
      <g id="fx-krackle" class="krackle"></g>
      <polygon id="fx-burst" class="burst" points="" />
    </svg>
    <svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
      <filter id="bh-warp" x="-25%" y="-25%" width="150%" height="150%">
        <feTurbulence type="fractalNoise" baseFrequency="0.011" numOctaves="2" seed="7" result="noise" />
        <feDisplacementMap id="bh-warp-map" in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <a class="corner" id="corner" href={withBase('/')} aria-hidden="true" tabindex="-1">
      <img id="corner-type" src={withBase('/logo-type-sm.webp')} alt="" width="78" height="56" />
    </a>

    <div class="actor" id="actor" aria-hidden="true">
      <div class="actor__pose">
        {FRAMES.map((src, i) => <img src={withBase('/' + src)} alt="" data-frame={i} width="1400" height="1404" />)}
      </div>
      <span class="actor__num"></span>
    </div>
  </div>
</BaseLayout>

<script>
  import { initLanding } from '../scripts/landing-motion';
  initLanding();
</script>

<style>
  /* ---------------- STAGE: one pinned screen holding every layer ---------------- */
  .stage { position: relative; container-type: inline-size; background: var(--paper); overflow: clip; }
  .stage:not(.is-pinned) { display: flex; flex-direction: column; }
  .stage:not(.is-pinned) > .layer-hero { order: -1; }
  .stage.is-pinned { height: 100svh; overflow: hidden; }
  .stage.is-pinned > .finale, .stage.is-pinned > .layer-hero { position: absolute; inset: 0; }

  .layer-hero, .half { --u: min(calc(100cqw / 1920), calc(100svh / 1171)); background: var(--gold); }
  .stage.is-pinned > .layer-hero { display: grid; place-items: center; z-index: 2; }
  .stage.is-pinned.is-split > .layer-hero { visibility: hidden; }
  .halves { display: none; }
  .stage.is-pinned .halves { display: block; position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .half { position: absolute; inset: 0; display: grid; place-items: center; visibility: hidden; }

  .fx, .corner, .actor { display: none; }
  .stage.is-pinned .fx { display: block; position: absolute; inset: 0; width: 100%; height: 100%; z-index: 4; pointer-events: none; overflow: visible; }
  .defs { position: absolute; width: 0; height: 0; }
  .trail-ink { fill: none; stroke: var(--black); stroke-linecap: round; stroke-linejoin: round; opacity: 0; }
  .trail { fill: none; stroke: var(--paper); stroke-linecap: round; stroke-linejoin: round; opacity: 0; }
  .speed line { stroke: var(--black); stroke-width: 3; stroke-linecap: round; visibility: hidden; }
  .krackle circle { fill: var(--black); }
  .burst { fill: #fff; stroke: var(--black); stroke-width: 4; stroke-linejoin: miter; visibility: hidden; }

  .stage.is-pinned .corner { display: block; position: absolute; top: 14px; left: var(--gutter); z-index: 5; line-height: 0; opacity: var(--corner-o, 0); pointer-events: none; }
  .stage.is-pinned .corner.is-live { pointer-events: auto; }
  .corner img { height: 56px; width: auto; }

  .stage.is-pinned .actor { display: block; position: absolute; left: 0; top: 0; z-index: 6; pointer-events: none; transform-origin: 50% 50%; visibility: hidden; }
  .actor.is-on { visibility: visible !important; }
  .actor__pose { position: absolute; inset: 0; transform-origin: 50% 50%; }
  .actor img { position: absolute; inset: 0; width: 100%; height: 100%; visibility: hidden; }
  .actor img.is-on { visibility: inherit; }
  .actor__num { display: none; }
  .actor[data-debug] .actor__num {
    display: grid; place-items: center; position: absolute; inset: 0;
    font-family: var(--font-display); font-weight: 700; font-size: 26svh; color: var(--gold); -webkit-text-stroke: 4px #000;
  }

  /* ---------------- HERO ---------------- */
  .hero {
    --p: 1;
    position: relative;
    width: calc(1920 * var(--u));
    height: calc(1171 * var(--u));
    margin: 0 auto;
    background: var(--gold);
    overflow: hidden;
  }
  .hero:focus-within { --p: 1 !important; }
  .rv, .rv-logo, .rv-cue { --t: clamp(0, calc((var(--p) - var(--a)) / (var(--b) - var(--a))), 1); }
  .rv { opacity: var(--t); translate: 0 calc((1 - var(--t)) * 30 * var(--u)); }
  .rv-logo { translate: 0 calc((1 - var(--t)) * 118 * var(--u)); }
  .rv-cue { opacity: calc(1 - var(--t)); }
  .stage.is-pinned .hero:not(.is-revealed) .hero__pills { pointer-events: none; }

  .w {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc(300 * var(--u));
    line-height: calc(242 * var(--u));
    letter-spacing: var(--track-display);
    white-space: nowrap;
  }
  .w--r { left: auto; right: calc(54 * var(--u)); }
  .hero__mobile-title { display: none; }
  .hero__logo {
    position: absolute;
    left: calc(703 * var(--u));
    top: calc(282 * var(--u));
    width: calc(515 * var(--u));
  }
  .hero__logo-type { display: block; width: 100%; height: auto; opacity: var(--bigtype, 1); }
  .hero__logo-surfer { position: absolute; height: auto; }
  .stage.is-launched .hero__logo-surfer { visibility: hidden; }
  .hero__rule {
    position: absolute;
    left: calc(649 * var(--u));
    top: calc(632 * var(--u));
    width: calc(622 * var(--u));
    height: calc(6 * var(--u));
    background: var(--black);
  }
  .hero__sub {
    position: absolute;
    left: calc(549 * var(--u));
    top: calc(654 * var(--u));
    width: calc(822 * var(--u));
    margin: 0;
    font-family: var(--font-pixel);
    font-size: calc(47 * var(--u));
    line-height: calc(37 * var(--u));
    letter-spacing: -0.042em;
    text-align: justify;
    text-align-last: left;
  }
  .hero__pills {
    position: absolute;
    left: calc(556 * var(--u));
    top: calc(794 * var(--u));
    display: flex;
    gap: calc(30 * var(--u));
  }
  .hero__star-wrap {
    position: absolute;
    left: calc(1637 * var(--u));
    top: calc(888 * var(--u));
    width: calc(242 * var(--u));
    height: calc(242 * var(--u));
  }
  .hero__star-wrap :global(.hero__star) { width: 100%; height: 100%; }
  .hero__cue {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(1060 * var(--u));
    margin: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: max(12px, calc(18 * var(--u)));
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .stage:not(.is-pinned) .hero__cue { display: none; }
  .hero__cue span { display: inline-block; }
  @media (prefers-reduced-motion: no-preference) {
    .hero__cue span { animation: cue-nudge 1.4s ease-in-out infinite; }
  }
  @keyframes cue-nudge { 50% { translate: 0 0.3em; } }

  /* ---------------- WHITE SECTION + FOOTER ---------------- */
  .finale { --p: 1; position: relative; background: var(--paper); }
  .stage.is-pinned > .finale { display: flex; flex-direction: column; z-index: 1; }
  .finale__main {
    --u: min(calc(100cqw / 1920), calc((100svh - 246px) / 560));
    display: grid;
    place-items: center;
    padding: 64px 0;
  }
  .stage.is-pinned .finale__main { flex: 1; padding: 0; }
  .foot-wrap { position: relative; z-index: 2; clip-path: inset(-200vh 0 0 0); }
  .foot-surfer {
    position: absolute;
    top: -30.8svh;
    left: calc(71cqw - 0.46 * 93.6svh);
    height: 93.6svh;
    width: auto;
    pointer-events: none;
  }
  .stage.is-pinned:not(.is-landed) .foot-surfer { visibility: hidden; }

  .st { position: relative; width: calc(1920 * var(--u)); height: calc(560 * var(--u)); }
  .sw, .bar { position: absolute; left: calc(var(--x) * var(--u)); top: calc(var(--y) * var(--u)); }
  .sw {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc(128 * var(--u));
    line-height: calc(132 * var(--u));
    letter-spacing: var(--track-statement);
    white-space: nowrap;
  }
  .sw--r { left: auto; right: calc(var(--r) * var(--u)); }
  .bar { width: calc(var(--w) * var(--u)); height: calc(var(--h) * var(--u)); background: var(--black); }
  .st__star-wrap {
    position: absolute;
    left: calc(1686 * var(--u));
    top: calc(22 * var(--u));
    width: calc(90 * var(--u));
    height: calc(90 * var(--u));
  }
  .st__star-wrap :global(.st__star) { width: 100%; height: 100%; }

  .prism-stage {
    position: absolute;
    left: calc(680 * var(--u));
    top: calc(128 * var(--u));
    width: calc(400 * var(--u));
    height: calc(114 * var(--u));
    perspective: calc(2400 * var(--u));
  }
  .prism {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    transform-style: preserve-3d;
    transform: translateZ(calc(-600 * var(--u))) rotateY(var(--spin, 0deg));
  }
  .face {
    position: absolute;
    inset: 0;
    transform: rotateY(calc(var(--i) * 120deg)) translateZ(calc(600 * var(--u)));
    font-family: var(--font-display);
    font-weight: 500;
    font-size: calc(26 * var(--u));
    line-height: calc(36 * var(--u));
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-align: justify;
    text-align-last: left;
  }
  @media (prefers-reduced-motion: reduce) {
    .prism-stage { left: calc(160 * var(--u)); width: calc(1440 * var(--u)); perspective: none; }
    .prism { display: flex; gap: calc(60 * var(--u)); transform: none; }
    .face { position: static; transform: none; flex: 1; }
  }
  .st__pills {
    position: absolute;
    right: calc(79 * var(--u));
    top: calc(305 * var(--u));
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: calc(10 * var(--u));
  }
  .st__mobile { display: none; }

  /* ---------------- PHONES (below 900px): reflow, no pinning ---------------- */
  @media (max-width: 899px) and (prefers-reduced-motion: no-preference) {
    .hero__mobile-title, .hero__logo, .hero__rule, .hero__sub, .hero__pills, .hero__star-wrap { animation: load-in 0.7s ease both; }
    .hero__mobile-title { animation-delay: 0.15s; }
    .hero__rule { animation-delay: 0.3s; }
    .hero__sub { animation-delay: 0.4s; }
    .hero__pills { animation-delay: 0.5s; }
    .hero__star-wrap { animation-delay: 0.6s; }
  }
  @keyframes load-in { from { opacity: 0; translate: 0 14px; } }

  @media (max-width: 899px) {
    .hero { width: auto; height: auto; padding: 28px var(--gutter) 40px; }
    .hero__words { display: none; }
    .hero__mobile-title {
      display: block;
      margin: 0 0 20px;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 17vw;
      line-height: 0.84;
      letter-spacing: var(--track-display);
      text-transform: uppercase;
    }
    .hero__logo, .hero__rule, .hero__sub, .hero__pills, .hero__star-wrap { position: static; translate: none; }
    .hero__logo { width: min(62%, 320px); display: block; margin: 0 auto; position: relative; left: auto; top: auto; }
    .hero__rule { width: min(84%, 460px); height: 5px; margin: 6px auto 12px; }
    .hero__sub { width: auto; font-size: 22px; line-height: 20px; }
    .hero__pills { flex-wrap: wrap; gap: 8px; margin-top: 18px; }
    .hero__pills :global(.pill--lg) { --h: 40px; }
    .hero__star-wrap { width: 64px; height: 64px; margin: 18px 0 0 auto; }

    .finale__main { padding: 32px var(--gutter) 24px; }
    .st { width: auto; height: auto; display: flex; flex-direction: column; }
    .st__desk, .st__star-wrap { display: none; }
    .st__mobile {
      display: block;
      order: -1;
      margin: 0 0 24px;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 11vw;
      line-height: 0.98;
      letter-spacing: var(--track-statement);
      text-transform: uppercase;
    }
    .ibar { display: inline-block; width: var(--w); height: 0.7em; background: var(--black); vertical-align: -0.02em; }
    .prism-stage { position: static; width: auto; height: auto; perspective: none; }
    .prism { display: grid; gap: 12px; transform: none; }
    .face { position: static; transform: none; font-size: 17px; line-height: 23px; padding: 12px 0; border-top: 2px solid var(--black); }
    .st__pills { position: static; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 20px; }
    .st__pills :global(.pill--lg) { --h: 40px; }
    .foot-surfer { display: none; }
  }
</style>
