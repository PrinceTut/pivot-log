---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPill from '../components/GlassPill.astro';
import StarBadge from '../components/StarBadge.astro';
import { withBase } from '../utils/url';
import { REPO_URL } from '../config';

// Statements exactly as written in the Figma file (TEXT nodes 31:17, 31:20, 31:23).
const statements = [
  'Most of what I build starts as scattered notes and half-formed questions.',
  'Patterns emerge once I start tracing how the pieces actually connect.',
  "What's left is a specific, testable claim; not a vibe.",
];

// Network graph for the grey slot (the previously approved sparse -> structure -> resolved
// visual), re-projected from its old 400x300 space onto the slot's 1119x567 proportions.
const X = (x: number) => 60 + x * 2.6;
const Y = (y: number) => 30 + y * 1.7;
const structureEdges = [[30,60,90,40],[90,40,160,55],[160,55,230,40],[230,40,300,30],[40,140,110,260],
  [200,220,280,190],[280,190,350,220],[110,260,200,220],[30,60,40,140],[170,130,200,220]];
const pathPoints = [[55,235],[120,190],[170,130],[245,100],[310,65],[355,50]];
const contextNodes = [[30,60],[90,40],[160,55],[230,40],[300,30],[370,90],[40,140],[110,260],[200,220],[280,190],[350,220],[200,270]];
const pathEdges = pathPoints.slice(1).map((p, i) => [...pathPoints[i], ...p]);

const heroSub = 'Independent projects and write-ups breaking down the LLM space and its components';
---

<BaseLayout title="Pivot Log" description="Independent projects and write-ups breaking down the LLM space and its components." nav={false}>
  <!-- HERO: Figma frame 31:3, rectangle 1920x1171 #f2cd53 -->
  <div class="cq">
    <section class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title" class="sr-only">Keeping up with the Frontier</h1>

      <div class="hero__words" aria-hidden="true">
        <span class="w" style="--x:21; --y:37">KEEPING</span>
        <span class="w w--r" style="--y:37">UP</span>
        <span class="w" style="--x:21; --y:320">WI</span>
        <span class="w w--r" style="--y:320">TH</span>
        <span class="w" style="--x:21; --y:603">TH</span>
        <span class="w w--r" style="--y:603">E</span>
        <span class="w" style="--x:21; --y:886">FRONTIER</span>
      </div>
      <p class="hero__mobile-title" aria-hidden="true">Keeping up with the frontier</p>

      <img class="hero__logo" src={withBase('/logo.webp')} alt="Pivot Log" width="729" height="402" fetchpriority="high" />
      <div class="hero__rule"></div>
      <p class="hero__sub">{heroSub}<span class="cursor" aria-hidden="true">|</span></p>

      <nav class="hero__pills" aria-label="Main">
        <GlassPill href={withBase('/projects')} label="Projects" size="lg" />
        <GlassPill href={withBase('/scratchnotes')} label="Scratchnotes" size="lg" />
        <GlassPill href={REPO_URL} label="Git Repo" size="lg" external />
      </nav>

      <StarBadge class="hero__star" />
    </section>
  </div>

  <!-- SLOT: Figma "Rectangle 7" 1119x567 #d9d9d9 (placeholder), filled with the network graph -->
  <div class="cq">
    <section class="slot" aria-label="From scattered notes to a testable claim">
      <figure class="slab">
        <svg class="graph" viewBox="0 0 1119 567" aria-hidden="true">
          <g class="g-structure">{structureEdges.map(([a,b,c,d]) => <line x1={X(a)} y1={Y(b)} x2={X(c)} y2={Y(d)} />)}</g>
          <g class="g-path">{pathEdges.map(([a,b,c,d]) => <line x1={X(a)} y1={Y(b)} x2={X(c)} y2={Y(d)} />)}</g>
          <g class="g-context">{contextNodes.map(([a,b]) => <circle cx={X(a)} cy={Y(b)} r="7" />)}</g>
          <g class="g-pathnodes">{pathPoints.map(([a,b]) => <circle cx={X(a)} cy={Y(b)} r="9" />)}</g>
        </svg>
        <figcaption class="slab__labels">
          <span class="lbl lbl--a">01 Notes</span>
          <span class="lbl lbl--b">02 Structure</span>
          <span class="lbl lbl--c">03 Claim</span>
        </figcaption>
      </figure>
    </section>
  </div>

  <!-- STATEMENT: Figma text node at (55,1814), 128px, with redaction bars and the prism -->
  <div class="cq">
    <section class="st" aria-labelledby="st-title">
      <h2 id="st-title" class="sr-only">A repository of all my tech perspectives</h2>

      <div class="st__desk" aria-hidden="true">
        <span class="sw" style="--x:55; --y:0">A</span>
        <span class="bar" style="--x:171; --y:22; --w:687; --h:90"></span>
        <span class="sw sw--r" style="--r:290; --y:0">REPOSITORY</span>
        <StarBadge fill="white" class="st__star" />
        <span class="sw sw--r" style="--r:78; --y:0">F</span>
        <span class="bar" style="--x:1659; --y:130; --w:182; --h:138"></span>
        <span class="sw" style="--x:55; --y:264">ALL MY</span>
        <span class="bar" style="--x:512; --y:286; --w:234; --h:90"></span>
        <span class="sw sw--r" style="--r:826; --y:264">TECH</span>
        <span class="bar" style="--x:1108; --y:286; --w:466; --h:90"></span>
        <span class="sw" style="--x:55; --y:396">PERSPECTIVES</span>
        <span class="bar" style="--x:1176; --y:414; --w:313; --h:90"></span>
      </div>

      <div class="prism-stage">
        <ul class="prism">
          {statements.map((s, i) => <li class="face" style={`--i:${i}`}>{s}</li>)}
        </ul>
      </div>

      <p class="st__mono">Independent research and writing on how systems actually behave.</p>

      <nav class="st__pills" aria-label="Explore">
        <GlassPill href={REPO_URL} label="Git Repo" size="lg" external />
        <GlassPill href={withBase('/projects')} label="Projects" size="lg" />
        <GlassPill href={withBase('/scratchnotes')} label="Scratchnotes" size="lg" />
      </nav>

      <!-- Mobile composition (below 900px): same content, reflowed -->
      <p class="st__mobile" aria-hidden="true">A <span class="ibar" style="--w:2.4em"></span> Repository of all my <span class="ibar" style="--w:1.2em"></span> tech <span class="ibar" style="--w:1.8em"></span> perspectives</p>
    </section>
  </div>
</BaseLayout>

<style>
  /* ---------------- HERO ---------------- */
  .hero {
    position: relative;
    height: calc(1171 * var(--u));
    background: var(--gold);
    overflow: hidden;
  }
  .w {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc(300 * var(--u));
    line-height: calc(242 * var(--u));
    letter-spacing: var(--track-display);
    white-space: nowrap;
  }
  .w--r { left: auto; right: calc(54 * var(--u)); }
  .hero__mobile-title { display: none; }
  .hero__logo {
    position: absolute;
    left: calc(596 * var(--u));
    top: calc(262 * var(--u));
    width: calc(729 * var(--u));
    height: auto;
  }
  .hero__rule {
    position: absolute;
    left: calc(649 * var(--u));
    top: calc(632 * var(--u));
    width: calc(622 * var(--u));
    height: calc(6 * var(--u));
    background: var(--black);
  }
  .hero__sub {
    position: absolute;
    left: calc(549 * var(--u));
    top: calc(654 * var(--u));
    width: calc(822 * var(--u));
    margin: 0;
    font-family: var(--font-pixel);
    font-size: calc(47 * var(--u));
    line-height: calc(37 * var(--u));
    letter-spacing: -0.042em;
    text-align: justify;
    text-align-last: left;
  }
  .hero__pills {
    position: absolute;
    left: calc(556 * var(--u));
    top: calc(794 * var(--u));
    display: flex;
    gap: calc(30 * var(--u));
  }
  .hero :global(.hero__star) {
    position: absolute;
    left: calc(1637 * var(--u));
    top: calc(888 * var(--u));
    width: calc(242 * var(--u));
    height: calc(242 * var(--u));
  }

  /* ---------------- SLOT (graph) ---------------- */
  .slot { padding: calc(43 * var(--u)) 0 0 calc(36 * var(--u)); }
  .slab {
    position: relative;
    margin: 0;
    width: calc(1119 * var(--u));
    height: calc(567 * var(--u));
    background: var(--slab);
  }
  .graph { width: 100%; height: 100%; display: block; }
  .graph line { stroke: var(--black); fill: none; }
  .g-structure line { stroke-width: 2; }
  .g-path line { stroke-width: 5; }
  .graph circle { fill: var(--black); }
  .slab__labels {
    position: absolute;
    left: calc(28 * var(--u));
    bottom: calc(22 * var(--u));
    display: flex;
    gap: calc(28 * var(--u));
    margin: 0;
    font-family: var(--font-mono);
    font-style: normal;
    font-weight: 700;
    font-size: max(11px, calc(17 * var(--u)));
    text-transform: uppercase;
    color: var(--black);
  }
  .lbl { opacity: 0.35; }

  /* Graph states follow the prism clock (7.92s): face 1 front at 0%, face 2 at 33%, face 3 at 67% */
  .g-structure { opacity: 0; } .g-path { opacity: 0; }
  .g-context, .g-pathnodes { opacity: 0.45; }
  @media (prefers-reduced-motion: no-preference) {
    .g-structure { animation: g-structure 7.92s linear infinite; }
    .g-path { animation: g-path 7.92s linear infinite; }
    .g-context { animation: g-context 7.92s linear infinite; }
    .g-pathnodes { animation: g-pathnodes 7.92s linear infinite; }
    .lbl--a { animation: lbl-a 7.92s linear infinite; }
    .lbl--b { animation: lbl-b 7.92s linear infinite; }
    .lbl--c { animation: lbl-c 7.92s linear infinite; }
  }
  @media (prefers-reduced-motion: reduce) {
    /* No motion: show the resolved end state */
    .g-structure { opacity: 0.15; } .g-path { opacity: 1; } .g-context { opacity: 0.3; } .g-pathnodes { opacity: 1; }
    .lbl--c { opacity: 1; }
  }
  @keyframes g-structure { 0%,13.7% {opacity:0} 19.7%,47% {opacity:.55} 53%,80.3% {opacity:.15} 86.3%,100% {opacity:0} }
  @keyframes g-path      { 0%,47% {opacity:0} 53%,80.3% {opacity:1} 86.3%,100% {opacity:0} }
  @keyframes g-context   { 0%,13.7% {opacity:.45} 19.7%,47% {opacity:.8} 53%,80.3% {opacity:.3} 86.3%,100% {opacity:.45} }
  @keyframes g-pathnodes { 0%,13.7% {opacity:.45} 19.7%,47% {opacity:.8} 53%,80.3% {opacity:1} 86.3%,100% {opacity:.45} }
  @keyframes lbl-a { 0%,13.7% {opacity:1} 19.7%,80.3% {opacity:.35} 86.3%,100% {opacity:1} }
  @keyframes lbl-b { 0%,13.7% {opacity:.35} 19.7%,47% {opacity:1} 53%,100% {opacity:.35} }
  @keyframes lbl-c { 0%,47% {opacity:.35} 53%,80.3% {opacity:1} 86.3%,100% {opacity:.35} }

  /* ---------------- STATEMENT ---------------- */
  .st {
    position: relative;
    height: calc(560 * var(--u));
    margin-top: calc(33 * var(--u));
  }
  .sw, .bar {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
  }
  .sw {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc(128 * var(--u));
    line-height: calc(132 * var(--u));
    letter-spacing: var(--track-statement);
    white-space: nowrap;
  }
  .sw--r { left: auto; right: calc(var(--r) * var(--u)); }
  .bar {
    width: calc(var(--w) * var(--u));
    height: calc(var(--h) * var(--u));
    background: var(--black);
  }
  .st :global(.st__star) {
    position: absolute;
    left: calc(1686 * var(--u));
    top: calc(22 * var(--u));
    width: calc(90 * var(--u));
    height: calc(90 * var(--u));
  }

  /* Prism: three panels on a vertical axis at x=805, one turn per 7.92s (GIF: 396 frames x 20ms) */
  .prism-stage {
    position: absolute;
    left: calc(680 * var(--u));
    top: calc(128 * var(--u));
    width: calc(400 * var(--u));
    height: calc(114 * var(--u));
    perspective: calc(2400 * var(--u));
  }
  .prism {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    transform-style: preserve-3d;
    transform: translateZ(calc(-600 * var(--u)));
  }
  .face {
    position: absolute;
    inset: 0;
    transform: rotateY(calc(var(--i) * 120deg)) translateZ(calc(600 * var(--u)));
    font-family: var(--font-display);
    font-weight: 500;
    font-size: calc(26 * var(--u));
    line-height: calc(36 * var(--u));
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-align: justify;
    text-align-last: left;
  }
  @media (prefers-reduced-motion: no-preference) {
    .prism { animation: prism-spin 7.92s linear infinite; }
  }
  @keyframes prism-spin {
    from { transform: translateZ(calc(-600 * var(--u))) rotateY(0deg); }
    to   { transform: translateZ(calc(-600 * var(--u))) rotateY(-360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    /* Flatten to three readable columns */
    .prism-stage { left: calc(160 * var(--u)); width: calc(1440 * var(--u)); perspective: none; }
    .prism { display: flex; gap: calc(60 * var(--u)); transform: none; }
    .face { position: static; transform: none; flex: 1; }
  }

  .st__mono {
    position: absolute;
    left: calc(961 * var(--u));
    top: calc(413 * var(--u));
    width: calc(194 * var(--u));
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: calc(17 * var(--u));
    line-height: calc(24 * var(--u));
    letter-spacing: -0.04em;
    text-align: justify;
    text-align-last: left;
  }
  .st__pills {
    position: absolute;
    right: calc(79 * var(--u));
    top: calc(305 * var(--u));
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: calc(10 * var(--u));
  }
  .st__mobile { display: none; }

  /* ---------------- MOBILE (below 900px): reflow instead of shrinking the poster ---------------- */
  @media (max-width: 899px) {
    .hero { height: auto; padding: 28px var(--gutter) 40px; }
    .hero__words { display: none; }
    .hero__mobile-title {
      display: block;
      margin: 0 0 20px;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 17vw;
      line-height: 0.84;
      letter-spacing: var(--track-display);
      text-transform: uppercase;
    }
    .hero__logo, .hero__rule, .hero__sub, .hero__pills { position: static; }
    .hero__logo { width: min(78%, 420px); display: block; margin: 0 auto; }
    .hero__rule { width: min(84%, 460px); height: 5px; margin: 6px auto 12px; }
    .hero__sub { width: auto; font-size: 22px; line-height: 20px; }
    .hero__pills { flex-wrap: wrap; gap: 8px; margin-top: 18px; }
    .hero__pills :global(.pill--lg) { --h: 40px; }
    .hero :global(.hero__star) { position: static; display: block; width: 64px; height: 64px; margin: 18px 0 0 auto; }

    .slot { padding: 20px var(--gutter) 0; }
    .slab { width: 100%; height: auto; aspect-ratio: 1119 / 567; }
    .slab__labels { font-size: 10px; gap: 12px; left: 10px; bottom: 8px; }

    .st { height: auto; margin-top: 0; padding: 32px var(--gutter) 8px; display: flex; flex-direction: column; }
    .st__mobile { order: -1; }
    .st__desk, .st :global(.st__star) { display: none; }
    .st__mobile {
      display: block;
      margin: 0 0 24px;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 11vw;
      line-height: 0.98;
      letter-spacing: var(--track-statement);
      text-transform: uppercase;
    }
    .ibar { display: inline-block; width: var(--w); height: 0.7em; background: var(--black); vertical-align: -0.02em; }
    .prism-stage { position: static; width: auto; height: auto; perspective: none; }
    .prism { display: grid; gap: 12px; transform: none; animation: none; }
    .face { position: static; transform: none; font-size: 17px; line-height: 23px; padding: 12px 0; border-top: 2px solid var(--black); }
    .st__mono { position: static; width: auto; font-size: 14px; line-height: 20px; margin: 20px 0; }
    .st__pills { position: static; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 8px; }
    .st__pills :global(.pill--lg) { --h: 40px; }
  }
</style>
