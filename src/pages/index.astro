---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';
import Button from '../components/Button.astro';
import type { ResearchMeta } from '../types';

// Real data — same self-updating glob mechanism as the /projects and
// /scratchnotes index pages. Homepage teasers are never hand-written copy.
const projectModules = import.meta.glob<{ meta: ResearchMeta }>('./projects/*.astro', {
  eager: true,
});
const projects = Object.entries(projectModules)
  .filter(([path]) => !path.endsWith('/index.astro'))
  .map(([, mod]) => mod.meta)
  .filter(Boolean)
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 2);

const noteModules = import.meta.glob<{ meta: ResearchMeta }>('./scratchnotes/*.astro', {
  eager: true,
});
const notes = Object.entries(noteModules)
  .filter(([path]) => !path.endsWith('/index.astro'))
  .map(([, mod]) => mod.meta)
  .filter(Boolean)
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 1);
---

<BaseLayout
  title="Pivot Log"
  description="Independent research and writing on how systems actually behave."
>
  <div class="home">
    <section class="hero">
      <h1>Keeping up with the Frontier</h1>
      <p class="sub">Independent projects and write-ups breaking down the LLM space and its components.</p>
      <Button href={withBase('/projects')}>Explore the projects</Button>
    </section>

    <section class="statement" id="statement-section">
      <h2 class="statement-heading">A REPOSITORY OF ALL MY TECH PERSPECTIVES.</h2>
      <div class="statement-grid">
        <div class="statement-list">
          <div class="statement-row" data-row-index="0">
            <span class="num">01</span>
            <span class="statement-text placeholder-text">Placeholder — first perspective, TBD</span>
          </div>
          <div class="statement-row" data-row-index="1">
            <span class="num">02</span>
            <span class="statement-text placeholder-text">Placeholder — second perspective, TBD</span>
          </div>
          <div class="statement-row" data-row-index="2">
            <span class="num">03</span>
            <span class="statement-text placeholder-text">Placeholder — third perspective, TBD</span>
          </div>
        </div>
        <div class="statement-visual-pin">
          <div class="placeholder-visual" id="scroll-visual">
            <span class="visual-label active" data-visual-index="0">Perspective 01 — illustration placeholder<br />(real artwork goes here)</span>
            <span class="visual-label" data-visual-index="1">Perspective 02 — illustration placeholder<br />(real artwork goes here)</span>
            <span class="visual-label" data-visual-index="2">Perspective 03 — illustration placeholder<br />(real artwork goes here)</span>
          </div>
        </div>
      </div>
    </section>

    <section class="teaser">
      <p class="kicker">Projects</p>
      <h2>My projects.</h2>
      <p class="teaser-intro">
        Exercises in building and breaking systems, to understand the
        mechanisms behind models, pipelines, and agents.
      </p>

      <div class="teaser-list">
        {projects.map((p, i) => (
          <a class="teaser-row" href={withBase(`/projects/${p.slug}`)}>
            <div class="row-visual" data-reveal>Illustration<br />placeholder</div>
            <span class="row-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="row-body">
              <span class="row-title">{p.title}</span>
              <span class="row-dek">{p.dek}</span>
            </span>
            {p.stats && p.stats.length > 0 && (
              <span class="row-stat">
                <span class="row-stat-value">{p.stats[p.stats.length - 1].value}</span>
                <span class="row-stat-label">{p.stats[p.stats.length - 1].label}</span>
              </span>
            )}
          </a>
        ))}
      </div>

      <Button href={withBase('/projects')}>Explore the projects</Button>
    </section>

    <section class="teaser">
      <p class="kicker">Scratchnotes</p>
      <h2>Scratchnotes.</h2>
      <p class="teaser-intro">
        A place to write about things I find important — faster and
        looser than a full project.
      </p>

      <div class="notes-card-wrap">
        {notes.map((n) => (
          <a class="notes-card" href={withBase(`/scratchnotes/${n.slug}`)}>
            <span class="notes-card-title">{n.title}</span>
            <span class="notes-card-dek">{n.dek}</span>
            <span class="notes-card-meta">{n.date} &middot; &rarr;</span>
          </a>
        ))}
      </div>

      <Button href={withBase('/scratchnotes')}>Read Scratchnotes</Button>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    width: 100%;
  }

  /* --- Hero: centered, full-bleed padding --- */
  .hero {
    padding: var(--space-24) var(--space-16) var(--space-16);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero h1 {
    font-family: var(--font-sans);
    font-size: 4.5rem;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--ink);
    max-width: 50rem;
    margin-bottom: var(--space-6);
  }
  .sub {
    font-family: var(--font-serif);
    font-size: var(--size-dek);
    color: var(--ink-soft);
    max-width: 34rem;
    margin-bottom: var(--space-8);
  }

  /* --- Statement section: full-bleed, huge type, scroll-linked visual --- */
  .statement {
    padding: var(--space-24) var(--space-16);
    border-top: var(--border);
  }

  .statement-heading {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 5.5rem;
    line-height: 1.02;
    letter-spacing: -0.01em;
    max-width: 64rem;
    margin: 0 0 var(--space-16) 0;
  }

  .statement-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-16);
    align-items: start;
  }

  .statement-list {
    border-top: var(--border);
  }
  .statement-row {
    display: flex;
    gap: var(--space-8);
    align-items: center;
    min-height: 40vh;
    padding: var(--space-6) 0;
    border-bottom: var(--border);
  }
  .statement-row .num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-soft);
    min-width: 2rem;
  }
  .statement-text {
    font-family: var(--font-serif);
    font-size: 1.25rem;
  }
  .placeholder-text {
    color: var(--ink-soft);
    font-style: italic;
  }

  .statement-visual-pin {
    position: sticky;
    top: 130px;
  }
  .placeholder-visual {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--paper-2);
    border: 1px dashed var(--line);
  }
  .visual-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-6);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.6;
    opacity: 0;
  }
  .visual-label.active {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .visual-label {
      transition: opacity var(--transition-reveal);
    }
  }

  @media (max-width: 899px) {
    .statement-grid {
      grid-template-columns: 1fr;
    }
    .statement-visual-pin {
      display: none;
    }
    .statement-row {
      min-height: 0;
    }
  }

  /* --- Teaser sections (Projects / Scratchnotes) --- */
  .teaser {
    padding: var(--space-24) var(--space-16);
    border-top: var(--border);
  }
  .kicker {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin-bottom: var(--space-3);
  }
  .teaser h2 {
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: -0.01em;
    font-size: 3.5rem;
    margin-bottom: var(--space-4);
  }
  .teaser-intro {
    font-family: var(--font-serif);
    font-size: var(--size-dek);
    color: var(--ink-soft);
    max-width: 40rem;
    margin-bottom: var(--space-12);
  }

  .teaser-list {
    max-width: 64rem;
    border-top: var(--border);
    margin-bottom: var(--space-8);
  }
  .teaser-row {
    display: grid;
    grid-template-columns: 6rem 3rem 1fr auto;
    gap: var(--space-8);
    align-items: center;
    padding: var(--space-8) 0;
    border-bottom: var(--border);
    text-decoration: none;
    color: inherit;
  }
  .row-visual {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: var(--paper-2);
    border: 1px dashed var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.5625rem;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1.4;
    padding: var(--space-1);
    opacity: 0;
    transform: translateY(16px);
  }
  .row-visual.is-visible {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .row-visual {
      transition: opacity var(--transition-reveal), transform var(--transition-reveal);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .row-visual {
      opacity: 1;
      transform: none;
    }
  }
  .row-num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }
  .row-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .row-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
  }
  .teaser-row:hover .row-title {
    text-decoration-color: var(--ink);
  }
  .row-dek {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--ink-soft);
    max-width: 34rem;
  }
  .row-stat {
    text-align: right;
    white-space: nowrap;
  }
  .row-stat-value {
    display: block;
    font-family: var(--font-sans);
    font-size: 2rem;
    font-weight: 600;
    color: var(--ink);
  }
  .row-stat-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--ink-soft);
    max-width: 10rem;
  }

  .notes-card-wrap {
    max-width: 36rem;
    margin-bottom: var(--space-8);
  }
  .notes-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6) 0;
    border-top: var(--border);
    border-bottom: var(--border);
    text-decoration: none;
    color: inherit;
  }
  .notes-card-title {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--ink);
  }
  .notes-card-dek {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
  .notes-card-meta {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  @media (max-width: 639px) {
    .hero, .statement, .teaser {
      padding-left: var(--space-4);
      padding-right: var(--space-4);
    }
    .hero h1, .statement-heading, .teaser h2 {
      font-size: 2.25rem;
    }
    .teaser-row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .row-visual {
      display: none;
    }
    .row-stat {
      text-align: left;
    }
  }
</style>

<script>
  // The pinned visual panel's stick-while-scrolling behavior is handled
  // natively by CSS `position: sticky` — no JS needed for that part.
  // This script's only job is tracking which numbered row is currently
  // near the vertical center of the viewport, and crossfading the
  // matching placeholder label into view (real illustrations will swap
  // in here once they exist, same mechanism).
  function setupStatementScroll() {
    const rows = document.querySelectorAll<HTMLElement>('.statement-row[data-row-index]');
    const labels = document.querySelectorAll<HTMLElement>('.visual-label[data-visual-index]');
    if (!rows.length || !labels.length) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const index = entry.target.getAttribute('data-row-index');
          labels.forEach((label) => {
            label.classList.toggle('active', label.getAttribute('data-visual-index') === index);
          });
        });
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
    );

    rows.forEach((row) => observer.observe(row));
  }

  document.addEventListener('astro:page-load', setupStatementScroll);

  // Per-project illustration placeholders on the homepage teaser: a
  // simple trigger-once fade-in as each row scrolls into view (not a
  // continuous crossfade like the statement section above — these are
  // independent list items, not one shared narrative panel, so each
  // just needs to appear once and stay).
  function setupProjectVisualReveal() {
    const visuals = document.querySelectorAll<HTMLElement>('.row-visual[data-reveal]');
    if (!visuals.length) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );

    visuals.forEach((visual) => observer.observe(visual));
  }

  document.addEventListener('astro:page-load', setupProjectVisualReveal);
</script>
