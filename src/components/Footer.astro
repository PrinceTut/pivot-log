---
import { withBase } from '../utils/url';
import { REPO_URL } from '../config';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__center">
    <p class="footer__spec">Built with Astro &middot; Statically generated &middot; Deployed via GitHub Actions</p>
    <p class="footer__credit">&copy; {year} Pivot Log &bull; pnksaus presents</p>
  </div>
  <nav class="footer__nav" aria-label="Footer">
    <a href={withBase('/projects')}>Projects</a>
    <a href={withBase('/scratchnotes')}>Scratchnotes</a>
    <a class="footer__gh" href={REPO_URL} target="_blank" rel="noopener noreferrer" aria-label="View source on GitHub">
      <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
    </a>
  </nav>
</footer>

<style>
  .footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: var(--space-4);
    padding: var(--space-24) var(--gutter) 16px;
    background: var(--paper);
  }
  .footer__center { grid-column: 2; text-align: center; }
  .footer__spec { font-family: var(--font-mono); font-size: 13px; line-height: 15px; color: var(--ink-soft); margin: 0 0 4px; }
  .footer__credit { font-family: var(--font-ui); font-weight: 300; font-size: 12px; line-height: 15px; letter-spacing: 0.02em; color: var(--ink-soft); margin: 0; }
  .footer__nav { grid-column: 3; justify-self: end; display: flex; align-items: center; gap: 36px; }
  .footer__nav a {
    font-family: var(--font-display); font-weight: 400; font-size: 13px; line-height: 15px;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--black); text-decoration: none;
  }
  .footer__nav a:hover { text-decoration: underline; text-decoration-color: var(--gold); }
  .footer__gh { display: flex; }

  @media (max-width: 899px) {
    .footer { grid-template-columns: 1fr; justify-items: center; padding-top: var(--space-16); }
    .footer__center, .footer__nav { grid-column: 1; }
    .footer__nav { justify-self: center; order: -1; margin-bottom: var(--space-4); }
  }
</style>
