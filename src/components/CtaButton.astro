---
// Solid call-to-action button: used where the site wants a clear "click here now"
// (the landing page's white section), instead of the decorative glass pill.
// primary = solid black; secondary = black outline. Both turn gold on hover.
interface Props {
  href: string;
  label: string;
  kind?: 'primary' | 'secondary';
  external?: boolean;
}
const { href, label, kind = 'primary', external = false } = Astro.props;
---

<a
  class:list={['cta', `cta--${kind}`]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span class="cta__label">{label}</span>
  <svg class="cta__arrow" viewBox="0 0 16 16" aria-hidden="true">
    {external
      ? <path d="M4.5 11.5 L11.5 4.5 M6 4.5 H11.5 V10" />
      : <path d="M2.5 8 H13 M9 4 L13 8 L9 12" />}
  </svg>
  {external && <span class="sr-only">(opens in a new tab)</span>}
</a>

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 46px;
    padding: 0 20px 0 22px;
    border: 2px solid var(--black);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }
  .cta--primary { background: var(--black); color: #fff; }
  .cta--secondary { background: transparent; color: var(--black); }
  .cta:hover { background: var(--gold); color: var(--black); }
  .cta:focus-visible { outline: 3px solid var(--black); outline-offset: 3px; }
  .cta__arrow { width: 16px; height: 16px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: square; }
  @media (prefers-reduced-motion: no-preference) {
    .cta { transition: background-color var(--transition-fast), color var(--transition-fast); }
    .cta__arrow { transition: transform var(--transition-fast); }
    .cta:hover .cta__arrow { transform: translateX(3px); }
    .cta--secondary:hover .cta__arrow { transform: translate(2px, -2px); }
  }
</style>
