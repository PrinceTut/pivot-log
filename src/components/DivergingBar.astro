---
interface BarItem {
  label: string;
  value: number;
}

interface Props {
  caption: string;
  items: BarItem[];
  scaleMax?: number;
}

const { caption, items, scaleMax = 6 } = Astro.props;

function widthPct(value: number) {
  return Math.min((Math.abs(value) / scaleMax) * 50, 50);
}
---

<figure class="diverging-bar">
  {items.map((item) => (
    <div class="row">
      <span class="label">{item.label}</span>
      <div class="track">
        <div class="zero-line"></div>
        <div
          class={`bar ${item.value >= 0 ? 'positive' : 'negative'}`}
          style={`width: ${widthPct(item.value)}%;`}
        ></div>
      </div>
      <span class={`value ${item.value >= 0 ? 'positive' : 'negative'}`}>
        {item.value > 0 ? '+' : ''}{item.value.toFixed(2)}
      </span>
    </div>
  ))}
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .diverging-bar { margin: var(--space-8) 0; }
  .row { display: grid; grid-template-columns: 11rem 1fr 4.5rem; align-items: center; gap: var(--space-3); padding: 3px 0; }
  .label { font-family: var(--font-display); font-weight: 700; font-size: 12px; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .track { position: relative; height: 18px; background: var(--slab); }
  .zero-line { position: absolute; left: 50%; top: -3px; bottom: -3px; width: 2px; margin-left: -1px; background: var(--black); }
  .bar { position: absolute; top: 0; bottom: 0; }
  .bar.positive { left: 50%; background: var(--positive); }
  .bar.negative { right: 50%; background: var(--negative); }
  .value { font-family: var(--font-mono); font-weight: 700; font-size: 0.875rem; text-align: right; }
  .value.positive { color: var(--positive); }
  .value.negative { color: var(--negative); }
  @media (max-width: 639px) { .row { grid-template-columns: 7.5rem 1fr 3.5rem; } }
</style>
