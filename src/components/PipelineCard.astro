---
// A project still being built: title, one-liner, why and how, what it's built with.
// "What comes out" sits under redaction bars that lift on hover or tap, as a teaser.
// The icon is a blueprint: dashed outline, nothing filled in yet.
interface Props {
  title: string;
  oneLiner: string;
  description: string;
  buildingWith: string[];
  comesOut: string;
  icon: 'levers' | 'scale';
}
const { title, oneLiner, description, buildingWith, comesOut, icon } = Astro.props;
---

<article class="pipe" tabindex="0">
  <div class="pipe__head">
    <div class="pipe__icon" aria-hidden="true">
      <svg viewBox="0 0 100 100">
        {icon === 'levers' && (
          <g>
            {[18, 40, 62, 84].map((x, i) => (
              <g>
                <line x1={x} y1="10" x2={x} y2="90" class="bp" />
                <rect x={x - 8} y={[58, 30, 70, 44][i]} width="16" height="10" class="bp" />
              </g>
            ))}
          </g>
        )}
        {icon === 'scale' && (
          <g>
            <line x1="50" y1="14" x2="50" y2="86" class="bp" />
            <line x1="16" y1="26" x2="84" y2="40" class="bp" />
            <polygon points="36,86 64,86 50,74" class="bp" />
            <rect x="6" y="26" width="22" height="22" class="bp" />
            <rect x="74" y="40" width="16" height="16" class="bp" />
          </g>
        )}
      </svg>
    </div>
    <div>
      <h3 class="pipe__title">{title}</h3>
      <p class="pipe__one">{oneLiner}</p>
    </div>
  </div>
  <p class="pipe__desc">{description}</p>
  <dl class="pipe__rows">
    <div><dt>Building with</dt><dd>{buildingWith.join(', ')}</dd></div>
    <div class="pipe__secret"><dt>What comes out</dt><dd><span class="pipe__redact">{comesOut}</span></dd></div>
  </dl>
</article>

<style>
  .pipe { position: relative; display: flex; flex-direction: column; gap: 16px; padding: 22px 22px 24px; border: 2px dashed var(--black); background: var(--paper); outline: none; }
  .pipe:focus-visible { outline: 3px solid var(--black); outline-offset: 3px; }
  .pipe__head { display: grid; grid-template-columns: 84px 1fr; gap: 18px; align-items: center; }
  .pipe__icon { width: 84px; height: 84px; padding: 12%; background: var(--gold); }
  .pipe__icon svg { width: 100%; height: 100%; overflow: visible; }
  .bp { fill: none; stroke: var(--black); stroke-width: 2; stroke-dasharray: 5 4; }
  .pipe__title { margin: 0 0 6px; font-size: clamp(22px, 2vw, 30px); line-height: 1; letter-spacing: var(--track-statement); text-transform: uppercase; }
  .pipe__one { margin: 0; font-family: var(--font-mono); font-size: 13px; line-height: 1.45; }
  .pipe__desc { margin: 0; font-size: 1rem; line-height: 1.6; }
  .pipe__rows { margin: 0; display: grid; gap: 10px; border-top: 2px solid var(--black); padding-top: 12px; }
  .pipe__rows div { display: grid; grid-template-columns: 9.5rem 1fr; gap: 12px; }
  .pipe__rows dt { font-family: var(--font-mono); font-weight: 700; font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; padding-top: 3px; }
  .pipe__rows dd { margin: 0; font-family: var(--font-mono); font-size: 13px; line-height: 1.5; }
  /* redaction: a black bar over the text until hover, focus or tap */
  .pipe__redact { background: var(--black); color: transparent; box-decoration-break: clone; -webkit-box-decoration-break: clone; padding: 0 2px; }
  .pipe:hover .pipe__redact, .pipe:focus-within .pipe__redact, .pipe:focus .pipe__redact { background: var(--gold); color: var(--black); }
  @media (prefers-reduced-motion: no-preference) { .pipe__redact { transition: background-color 0.25s ease, color 0.25s ease; } }
  @media (max-width: 639px) {
    .pipe__head { grid-template-columns: 64px 1fr; }
    .pipe__icon { width: 64px; height: 64px; }
    .pipe__rows div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
