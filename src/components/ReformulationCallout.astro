---
interface Props {
  label: string;
  before: string;
  after: string;
}

const { label, before, after } = Astro.props;
---

<figure class="reformulation">
  <figcaption class="label">{label}</figcaption>
  <div class="pair">
    <div class="before">
      <span class="tag">Original</span>
      <p>&ldquo;{before}&rdquo;</p>
    </div>
    <div class="arrow" aria-hidden="true">&rarr;</div>
    <div class="after">
      <span class="tag">Rewritten</span>
      <p>&ldquo;{after}&rdquo;</p>
    </div>
  </div>
</figure>

<style>
  .reformulation {
    margin: var(--space-6) 0;
    max-width: var(--content-width-wide);
  }

  .label {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
    margin-bottom: var(--space-3);
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);
  }

  .before, .after {
    padding: var(--space-3) var(--space-4);
    background: var(--paper-2);
  }
  .after {
    border-left: 2px solid var(--accent);
  }

  .tag {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
    margin-bottom: var(--space-1);
  }

  .before p, .after p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .arrow {
    color: var(--ink-soft);
    font-size: 1.25rem;
  }

  @media (max-width: 639px) {
    .pair {
      grid-template-columns: 1fr;
    }
    .arrow {
      transform: rotate(90deg);
      justify-self: start;
      margin-left: var(--space-4);
    }
  }
</style>
