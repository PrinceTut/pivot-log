---
interface Props {
  label: string;
  before: string;
  after: string;
}

const { label, before, after } = Astro.props;
---

<figure class="reformulation">
  <figcaption class="label">{label}</figcaption>
  <div class="pair">
    <div class="before">
      <span class="tag">Original</span>
      <p>{before}</p>
    </div>
    <div class="arrow" aria-hidden="true">&rarr;</div>
    <div class="after">
      <span class="tag">Rewritten</span>
      <p>{after}</p>
    </div>
  </div>
</figure>

<style>
  .reformulation { margin: var(--space-8) 0; }
  .label { font-family: var(--font-mono); font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: var(--space-3); font-style: normal; color: var(--black); }
  .pair { display: grid; grid-template-columns: 1fr auto 1fr; align-items: stretch; gap: var(--space-3); }
  .before, .after { padding: var(--space-4); }
  .before { background: var(--slab); }
  .after { background: var(--black); color: var(--gold); }
  .tag { display: block; font-family: var(--font-mono); font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--space-2); opacity: 0.75; }
  .before p, .after p { margin: 0; font-family: var(--font-mono); font-size: 0.875rem; line-height: 1.5; }
  .arrow { align-self: center; font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; }
  @media (max-width: 639px) {
    .pair { grid-template-columns: 1fr; }
    .arrow { transform: rotate(90deg); justify-self: start; margin-left: var(--space-4); }
  }
</style>
