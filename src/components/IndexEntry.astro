---
import type { ResearchStat } from '../types';
import { withBase } from '../utils/url';
import GlassPill from './GlassPill.astro';
import PieceIcon from './PieceIcon.astro';

interface Props {
  href: string;          // site-internal path, e.g. '/projects/my-slug' (base-prefixed here)
  slug: string;
  index: number;
  title: string;
  dek: string;
  description?: string;
  stats?: ResearchStat[];
  linkLabel?: string;
  extra?: { href: string; label: string }; // optional second link, e.g. a live MVP
}
const { href, slug, index, title, dek, description, stats, linkLabel = 'Read the paper', extra } = Astro.props;
const link = withBase(href);
---

<article class="entry" data-scroll-entry>
  <p class="entry__num" aria-hidden="true">{String(index).padStart(2, '0')}</p>
  <a class="entry__icon" href={link} tabindex="-1" aria-hidden="true"><PieceIcon slug={slug} /></a>
  <div class="entry__body">
    <h2 class="entry__title"><a href={link}>{title}</a></h2>
    <p class="entry__dek">{dek}</p>
    {description && <p class="entry__desc">{description}</p>}
    {stats && stats.length > 0 && (
      <dl class="entry__stats">
        {stats.map((s) => (<div><dt>{s.value}</dt><dd>{s.label}</dd></div>))}
      </dl>
    )}
    <div class="entry__links">
      <GlassPill href={link} label={linkLabel} size="md" />
      {extra && <GlassPill href={withBase(extra.href)} label={extra.label} size="md" external />}
    </div>
  </div>
</article>

<style>
  .entry {
    display: grid;
    grid-template-columns: 180px 150px minmax(0, 1fr);
    gap: 40px;
    padding: 48px 0 56px;
    border-top: 2px solid var(--black);
    opacity: 1;
  }
  .entry:first-child { border-top: var(--rule); }
  /* JS only ever adds dimming; 0.75 keeps the dimmed text at WCAG AA (4.7:1) */
  .entry.dimmed { opacity: 0.75; }
  @media (prefers-reduced-motion: no-preference) { .entry { transition: opacity var(--transition-reveal); } }

  .entry__num {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 150px;
    line-height: 0.78;
    letter-spacing: var(--track-display);
  }
  .entry__icon { display: block; width: 150px; height: 150px; }
  .entry__icon:hover :global(.piece-icon) { --icon-bg: var(--black); color: var(--gold); }

  .entry__title { margin: 0 0 16px; font-size: clamp(28px, 3vw, 52px); line-height: 0.95; letter-spacing: var(--track-statement); text-transform: uppercase; }
  .entry__title a { text-decoration: none; color: inherit; }
  .entry__title a:hover { text-decoration: underline; text-decoration-color: var(--gold); text-decoration-thickness: 0.12em; }
  .entry__dek { font-size: 1.1875rem; line-height: 1.5; margin: 0 0 12px; max-width: 46rem; }
  .entry__desc { font-size: 1rem; line-height: 1.6; color: var(--ink-soft); margin: 0 0 24px; max-width: 46rem; }

  .entry__links { display: flex; flex-wrap: wrap; gap: 10px; }
  .entry__stats { display: flex; flex-wrap: wrap; gap: 20px 48px; margin: 0 0 28px; }
  .entry__stats dt { font-family: var(--font-display); font-weight: 700; font-size: 44px; line-height: 1; letter-spacing: var(--track-statement); }
  .entry__stats dd { margin: 4px 0 0; font-family: var(--font-mono); font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; }

  @media (max-width: 1099px) {
    .entry { grid-template-columns: 110px minmax(0, 1fr); }
    .entry__num { font-size: 96px; }
    .entry__icon { grid-column: 1; grid-row: 2; width: 110px; height: 110px; }
    .entry__body { grid-column: 2; grid-row: 1 / span 2; }
  }
  @media (max-width: 639px) {
    .entry { grid-template-columns: 1fr; gap: 16px; padding: 32px 0 40px; }
    .entry__num { font-size: 72px; }
    .entry__icon { display: none; }
    .entry__body { grid-column: 1; grid-row: auto; }
    .entry__stats dt { font-size: 34px; }
    .entry__stats { gap: 16px 28px; }
  }
</style>
