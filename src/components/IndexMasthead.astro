---
// Masthead for the Projects and Scratchnotes index pages. Mirrors the landing hero:
// display words split to opposite edges (like "WI ... TH"), pixel-serif intro with
// the blinking cursor, spinning badge, and a large count as a visual anchor.
import StarBadge from './StarBadge.astro';

interface Props {
  theme: 'gold' | 'dark';
  title: string;             // accessible page title
  rows: string[][];          // display rows; items spread edge to edge, '*' = spinning badge
  intro: string;
  count: number;
  countLabel: string;
}
const { theme, title, rows, intro, count, countLabel } = Astro.props;
---

<div class="cq">
  <header class:list={['im', `im--${theme}`]}>
    <h1 class="sr-only">{title}</h1>
    <div class="im__words" aria-hidden="true">
      {rows.map((row) => (
        <div class="im__row">{row.map((item) => item === '*' ? <StarBadge class="im__star" /> : <span>{item}</span>)}</div>
      ))}
    </div>
    <div class="im__bottom">
      <p class="im__intro">{intro}<span class="cursor" aria-hidden="true">|</span></p>
      <p class="im__count"><span class="im__num">{String(count).padStart(2, '0')}</span><span class="im__label">{countLabel}</span></p>
    </div>
  </header>
</div>

<style>
  .im { padding: max(12px, calc(20 * var(--u))) calc(54 * var(--u)) max(36px, calc(70 * var(--u))) calc(21 * var(--u)); }
  .im--gold { background: var(--gold); color: var(--black); }
  .im--dark { background: var(--black); color: var(--gold); }

  .im__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc(300 * var(--u));
    line-height: calc(250 * var(--u));
    letter-spacing: var(--track-display);
    white-space: nowrap;
  }
  .im__bottom {
    display: grid;
    grid-template-columns: minmax(0, calc(822 * var(--u))) 1fr;
    gap: calc(60 * var(--u));
    align-items: end;
    margin-top: calc(40 * var(--u));
    padding-left: calc(6 * var(--u));
  }
  .im__row :global(.im__star) { flex: none; width: calc(215 * var(--u)); height: calc(215 * var(--u)); }
  .im__intro {
    margin: 0;
    font-family: var(--font-pixel);
    font-size: calc(47 * var(--u));
    line-height: calc(40 * var(--u));
    letter-spacing: -0.042em;
    text-align: justify;
    text-align-last: left;
  }
  .im--dark .im__intro { color: #fff; }
  .im__count { justify-self: end; margin: 0; display: flex; flex-direction: column; align-items: flex-end; }
  .im__num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc(220 * var(--u));
    line-height: 0.8;
    letter-spacing: var(--track-display);
  }
  .im__label {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: max(12px, calc(17 * var(--u)));
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 899px) {
    .im { padding: 12px var(--gutter) 32px; }
    .im__row { font-size: 16vw; line-height: 0.86; }
    .im__bottom { grid-template-columns: 1fr auto; gap: 16px; margin-top: 16px; padding-left: 0; }
    .im__row :global(.im__star) { width: 11vw; height: 11vw; }
    .im__intro { grid-column: 1 / -1; font-size: 21px; line-height: 19px; }
    .im__num { font-size: 72px; }
    .im__count { grid-column: 1 / -1; flex-direction: row; align-items: baseline; gap: 10px; justify-self: start; }
  }
</style>
