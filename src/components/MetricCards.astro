---
interface Metric {
  value: string;
  label: string;
  note: string;
}

interface Props {
  metrics: Metric[];
}

const { metrics } = Astro.props;
---

<div class="metric-cards">
  {metrics.map((m) => (
    <div class="metric">
      <div class="value">{m.value}</div>
      <div class="label">{m.label}</div>
      <p class="note">{m.note}</p>
    </div>
  ))}
</div>

<style>
  .metric-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: var(--space-8); margin: var(--space-8) 0; padding-top: var(--space-4); border-top: var(--rule); }
  .value { font-family: var(--font-display); font-weight: 700; font-size: clamp(40px, 4vw, 64px); line-height: 0.95; letter-spacing: var(--track-statement); }
  .label { font-family: var(--font-mono); font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; margin: var(--space-2) 0; }
  .note { font-size: 1rem; line-height: 1.5; margin: 0; }
</style>
