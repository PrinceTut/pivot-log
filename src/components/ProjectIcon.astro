---
// One icon per project, each abstracting that project's own centrepiece, drawn to one
// shared rule set: 100x100 square, outlined black cells, solid black = the part that matters.
//   rag-chunking-and-retrieval: the 5x4 chunker x retrieval grid, with Contextual + Hybrid
//     (+5.14, the largest and most significant result) filled.
//   building-an-slm: from the author's own note on LoRA ("under 1% of the model actually
//     trains"): eight frozen layers, each with a small trainable adapter slice.
interface Props { slug: string; }
const { slug } = Astro.props;

const grid: { x: number; y: number; on: boolean }[] = [];
if (slug === 'rag-chunking-and-retrieval') {
  for (let r = 0; r < 5; r++) for (let c = 0; c < 4; c++)
    grid.push({ x: 12 + c * 20, y: 2 + r * 20, on: r === 4 && c === 0 });
}
const layers = slug === 'building-an-slm' ? Array.from({ length: 8 }, (_, i) => 6 + i * 11.5) : [];
const known = grid.length > 0 || layers.length > 0;
---

{known && (
  <svg class="picon" viewBox="0 0 100 100" aria-hidden="true">
    {grid.map((c) => <rect x={c.x} y={c.y} width="16" height="16" class:list={['cell', { on: c.on }]} />)}
    {layers.map((y) => (
      <g>
        <rect x="8" y={y} width="84" height="8" class="cell" />
        <rect x="70" y={y} width="7" height="8" class="cell on" />
      </g>
    ))}
  </svg>
)}

<style>
  .picon { display: block; width: 100%; height: 100%; }
  .cell { fill: none; stroke: #000; stroke-width: 2; }
  .cell.on { fill: #000; }
</style>
