---
import type { ResearchStat } from '../types';

interface Props {
  stats: ResearchStat[];
}

const { stats } = Astro.props;
---

<dl class="stat-strip">
  {stats.map((stat) => (
    <div class="stat">
      <dt class="value">{stat.value}</dt>
      <dd class="label">{stat.label}</dd>
    </div>
  ))}
</dl>

<style>
  .stat-strip {
    display: flex;
    flex-wrap: wrap;
    gap: max(20px, calc(40 * var(--u, 1px))) max(28px, calc(90 * var(--u, 1px)));
    margin: max(28px, calc(56 * var(--u, 1px))) 0 0;
    padding-top: 16px;
    border-top: var(--rule);
  }
  .stat { margin: 0; }
  .value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: max(34px, calc(96 * var(--u, 1px)));
    line-height: 0.95;
    letter-spacing: var(--track-statement);
  }
  .label {
    margin: 6px 0 0;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
