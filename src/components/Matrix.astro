---
export interface MatrixCell {
  value: number;
  note: string;
}

export interface MatrixRow {
  label: string;
  plainScore: string;
  cells: MatrixCell[]; // must align 1:1 with `columns`
}

interface Props {
  caption: string;
  columns: string[];
  rows: MatrixRow[];
}

const { caption, columns, rows } = Astro.props;

// Minimal styling: no background fill, just a thin border indicating sign.
// (Reversed from the earlier continuous-heat-scale approach; user found
// the solid color fills too visually loud.)
function cellStyle(value: number) {
  if (value > 0) return 'border-bottom-color: var(--positive);';
  if (value < 0) return 'border-bottom-color: var(--negative);';
  return '';
}
function formatValue(value: number) {
  const sign = value > 0 ? '+' : '';
  return `${sign}${value.toFixed(2)}`;
}
---

<div class="matrix-wrap">
  <div class="matrix-scroll">
  <table class="matrix">
    <caption>{caption}</caption>
    <thead>
      <tr>
        <th scope="col"></th>
        {columns.map((col) => <th scope="col">{col}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row"><span class="rowname">{row.label}</span><span class="rowscore">{row.plainScore}</span></th>
          {row.cells.map((cell, ci) => (
            <td>
              <button
                type="button"
                class="matrix-cell"
                style={cellStyle(cell.value)}
                data-note={cell.note}
                data-title={`${row.label} + ${columns[ci].replace(/^\+\s*/, '')}`}
                data-value={formatValue(cell.value)}
                aria-describedby="matrix-panel"
              >
                {formatValue(cell.value)}
              </button>
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
  </div>

  <div id="matrix-panel" class="matrix-panel" aria-live="polite">
    <p class="hint">Select a cell to see the finding for that combination.</p>
  </div>
</div>

<style>
  .matrix-wrap { margin: var(--space-8) 0; }
  .matrix-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; width: 100%; }
  .matrix { width: 100%; border-collapse: separate; border-spacing: 6px; font-family: var(--font-mono); }
  .matrix caption { font-family: var(--font-body); margin-bottom: var(--space-2); }
  .matrix th, .matrix td { border: none; padding: 0; text-align: center; white-space: nowrap; background: none; }
  .matrix thead th {
    color: var(--black);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding-bottom: 4px;
  }
  .rowname, .rowscore { display: block; }
  .rowscore { font-family: var(--font-mono); font-weight: 400; font-size: 11px; text-transform: none; margin-top: 2px; }
  .matrix tbody th {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    text-align: left;
    text-transform: uppercase;
    padding-right: var(--space-3);
  }
  .matrix-cell {
    width: 100%;
    min-width: 4.75rem;
    padding: 12px 10px;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--black);
    background: var(--paper);
    border: 2px solid var(--black);
    border-bottom-width: 5px;
    cursor: pointer;
  }
  .matrix-cell:hover { background: var(--gold); }
  .matrix-cell.active { background: var(--black); color: var(--gold); }
  @media (prefers-reduced-motion: no-preference) {
    .matrix-cell { transition: background-color var(--transition-fast), color var(--transition-fast); }
  }
  .matrix-panel {
    margin-top: var(--space-3);
    padding: var(--space-4) var(--space-6);
    background: var(--black);
    color: #fff;
    min-height: 5.5rem;
  }
  .matrix-panel .hint { color: #c9ccd0; margin: 0; font-family: var(--font-mono); font-size: 13px; text-transform: uppercase; letter-spacing: 0.03em; }
  .matrix-panel :global(.panel-title) {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--gold);
  }
  .matrix-panel :global(p) { margin: 0; }
  @media (max-width: 639px) {
    .matrix-cell { padding: 16px 10px; }
  }
</style>

<script>
  // Progressive enhancement only: the notes are only reachable this way
  // now (the always-visible appendix fallback was removed per request).
  const cells = document.querySelectorAll<HTMLButtonElement>('.matrix-cell');
  const panel = document.getElementById('matrix-panel');

  cells.forEach((cell) => {
    cell.addEventListener('click', () => {
      cells.forEach((c) => c.classList.remove('active'));
      cell.classList.add('active');
      if (panel) {
        panel.innerHTML = `
          <p class="panel-title">${cell.dataset.title} (${cell.dataset.value})</p>
          <p>${cell.dataset.note}</p>
        `;
      }
    });
  });
</script>
