---
// Black pill with a "glass" label, approximating the Figma GLASS effect
// (refraction 0.98, chromatic aberration 0.52, specular -45deg), which has no
// CSS equivalent. At rest: chrome-gradient text plus mirrored copies peeking
// through the top and bottom edges. On hover/focus (0.05s in the prototype):
// clean white text. `active` keeps the clean state and marks the current page.
interface Props {
  href: string;
  label: string;
  size?: 'lg' | 'md' | 'sm';
  active?: boolean;
  external?: boolean;
}
const { href, label, size = 'md', active = false, external = false } = Astro.props;
---

<a
  class:list={['pill', `pill--${size}`, { 'pill--active': active }]}
  href={href}
  data-label={label}
  aria-current={active ? 'page' : undefined}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
><span class="pill__text">{label}</span></a>

<style>
  .pill {
    --h: 44px;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--h);
    padding: 0 calc(var(--h) * 0.36);
    border-radius: 999px;
    overflow: hidden;
    background:
      radial-gradient(90% 70% at 50% 50%, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0) 70%),
      linear-gradient(180deg, #8d949b 0%, #1d1f22 22%, #000 50%, #1d1f22 78%, #7f8a96 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.22),
      inset 1px 2px 2px rgba(255, 255, 255, 0.5),
      inset -1px -2px 3px rgba(96, 150, 255, 0.45),
      inset calc(var(--h) * 0.2) 0 calc(var(--h) * 0.22) calc(var(--h) * -0.12) rgba(176, 124, 72, 0.6),
      inset calc(var(--h) * -0.2) 0 calc(var(--h) * 0.22) calc(var(--h) * -0.12) rgba(88, 140, 232, 0.6);
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: calc(var(--h) * 0.6);
    letter-spacing: -0.027em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
    color: #fff;
    isolation: isolate;
  }
  .pill--lg { --h: calc(61 * var(--u, 1px)); min-height: 36px; }
  .pill--md { --h: 44px; }
  .pill--sm { --h: 34px; }

  /* Chrome gradient shared by the label and its refracted copies */
  .pill__text,
  .pill::before,
  .pill::after {
    background: linear-gradient(180deg,
      #ffffff 0%, #e4e8ec 28%, #57493b 46%, #d9d3cb 55%, #c3d2e3 73%, #ffffff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .pill__text {
    position: relative;
    z-index: 2;
    display: inline-block;
    transform: scaleY(1.22);
    filter: drop-shadow(1.2px 0 0 rgba(70, 140, 255, 0.9)) drop-shadow(-1px 0 0 rgba(255, 140, 50, 0.5));
  }
  /* Mirrored copies: the lens edge reflecting the label back at the top and bottom */
  .pill::before,
  .pill::after {
    content: attr(data-label);
    position: absolute;
    left: 0;
    right: 0;
    text-align: center;
    z-index: 1;
    opacity: 0.95;
    pointer-events: none;
    filter: blur(0.6px) drop-shadow(1px 0 0 rgba(70, 140, 255, 0.7));
  }
  .pill::before { top: -0.4em; transform: scale(1.1, -1.12); }
  .pill::after { bottom: -0.4em; transform: scale(1.1, -1.12); }

  /* Clean state: hover, keyboard focus, and the current page */
  .pill:hover .pill__text,
  .pill:focus-visible .pill__text,
  .pill--active .pill__text {
    background: none;
    color: #fff;
    transform: none;
    filter: none;
  }
  .pill:hover, .pill:focus-visible, .pill--active { background: #000; }
  .pill--active .pill__text { color: var(--gold); }
  .pill:hover::before, .pill:hover::after,
  .pill:focus-visible::before, .pill:focus-visible::after,
  .pill--active::before, .pill--active::after { opacity: 0; }

  @media (prefers-reduced-motion: no-preference) {
    .pill::before, .pill::after { transition: opacity 0.05s linear; }
  }
  .pill:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
</style>
