---
import { withBase } from '../utils/url';

// Placeholder — swap for the real repo once this project is actually
// pushed to GitHub.
const REPO_URL = 'https://github.com/PrinceTut/pivot-log';

// Active-page indication — no pill background (per earlier decision),
// just a color/underline change on whichever section you're in.
const path = Astro.url.pathname;
const isProjects = path.includes('/projects');
const isScratchnotes = path.includes('/scratchnotes');
---

<header class="nav" id="site-nav">
  <a class="wordmark" href={withBase('/')}>
    <img src={withBase('/logo.png')} alt="Pivot Log" class="logo-img" />
  </a>
  <nav class="links">
    <a href={withBase('/projects')} class={isProjects ? 'active' : ''} aria-current={isProjects ? 'page' : undefined}>Projects</a>
    <a href={withBase('/scratchnotes')} class={isScratchnotes ? 'active' : ''} aria-current={isScratchnotes ? 'page' : undefined}>Scratchnotes</a>
    <a class="icon-link" href={REPO_URL} target="_blank" rel="noopener noreferrer" aria-label="View source on GitHub">
      <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
      </svg>
    </a>
  </nav>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin: 0;
    padding: var(--space-6) var(--space-16);
    position: sticky;
    top: 0;
    z-index: 50;
    background: transparent;
    border-bottom: 1px solid transparent;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav {
      transition: background-color var(--transition-fast), border-color var(--transition-fast);
    }
  }
  .nav.scrolled {
    background: var(--paper);
    border-bottom-color: var(--line);
  }

  .wordmark {
    display: flex;
    align-items: center;
  }

  .logo-img {
    height: 64px;
    width: auto;
    display: block;
  }

  .links {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .icon-link {
    display: flex;
    align-items: center;
    color: var(--ink-soft);
  }
  .icon-link:hover {
    color: var(--ink);
  }

  .links a:not(.icon-link) {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 2px solid transparent;
  }
  .links a:not(.icon-link):hover {
    color: var(--ink);
  }
  .links a.active {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  @media (max-width: 639px) {
    .nav {
      padding: var(--space-4);
    }
    .logo-img {
      height: 40px;
    }
    .links {
      gap: var(--space-4);
    }
    .links a:not(.icon-link) {
      font-size: 0.75rem;
    }
  }
</style>

<script>
  // Sticky nav gains a solid background + hairline border as soon as the
  // page scrolls at all, reverting to transparent at the very top.
  // Wrapped in astro:page-load (not a bare top-level listener) because
  // this component's script is shared across every page and would
  // otherwise only run once, on the very first load — not after each
  // client-side page transition.
  function setupNavScroll() {
    const nav = document.getElementById('site-nav');
    if (!nav) return;

    function updateNavState() {
      if (window.scrollY > 0) {
        nav!.classList.add('scrolled');
      } else {
        nav!.classList.remove('scrolled');
      }
    }

    window.addEventListener('scroll', updateNavState, { passive: true });
    updateNavState();
  }

  document.addEventListener('astro:page-load', setupNavScroll);
</script>
