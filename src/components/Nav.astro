---
import { withBase } from '../utils/url';
import { REPO_URL } from '../config';
import GlassPill from './GlassPill.astro';

// Inner pages only (the landing hero carries its own logo and pills).
// theme = the colour of the masthead directly underneath, so the bar blends into it.
interface Props { theme?: 'gold' | 'dark' | 'paper'; }
const { theme = 'paper' } = Astro.props;

const path = Astro.url.pathname;
const isProjects = path.includes('/projects');
const isScratchnotes = path.includes('/scratchnotes');
---

<header class:list={['nav', `nav--${theme}`]} id="site-nav">
  <a class="nav__logo" href={withBase('/')} aria-label="Pivot Log home">
    <img class="logo-dark" src={withBase('/logo-sm.webp')} alt="" width="78" height="56" />
    <img class="logo-light" src={withBase('/logo-sm-light.webp')} alt="" width="78" height="56" />
  </a>
  <nav class="nav__pills" aria-label="Main">
    <GlassPill href={withBase('/projects')} label="Projects" size="sm" active={isProjects} />
    <GlassPill href={withBase('/scratchnotes')} label="Scratchnotes" size="sm" active={isScratchnotes} />
    <GlassPill href={REPO_URL} label="Git Repo" size="sm" external />
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 14px var(--gutter);
    border-bottom: 2px solid transparent;
  }
  .nav--gold { background: var(--gold); }
  .nav--dark { background: var(--black); }
  .nav--paper { background: var(--paper); }
  .nav.scrolled { background: var(--paper); border-bottom-color: var(--black); }
  @media (prefers-reduced-motion: no-preference) {
    .nav { transition: background-color var(--transition-reveal), border-color var(--transition-reveal); }
  }

  .nav__logo { display: flex; line-height: 0; text-decoration: none; }
  .nav__logo img { height: 56px; width: auto; }
  .logo-light { display: none; }
  .nav--dark:not(.scrolled) .logo-dark { display: none; }
  .nav--dark:not(.scrolled) .logo-light { display: block; }

  .nav__pills { display: flex; align-items: center; gap: 10px; }

  @media (max-width: 639px) {
    .nav { padding: 10px var(--gutter); }
    .nav__logo img { height: 38px; }
    .nav__pills { gap: 5px; }
    .nav__pills :global(.pill--sm) { --h: 28px; font-size: 14px; padding: 0 9px; }
  }
  @media (max-width: 400px) {
    .nav__logo img { height: 32px; }
    .nav__pills :global(.pill--sm) { --h: 26px; font-size: 12.5px; padding: 0 7px; }
  }
</style>

<script>
  // Solid paper bar + black rule once the page scrolls. astro:page-load so it
  // re-binds after every client-side page transition, not just the first load.
  // Listener is removed on navigation (the window persists across page transitions).
  let off: (() => void) | null = null;
  function setupNavScroll() {
    off?.(); off = null;
    const nav = document.getElementById('site-nav');
    if (!nav) return;
    const update = () => nav.classList.toggle('scrolled', window.scrollY > 8);
    window.addEventListener('scroll', update, { passive: true });
    update();
    off = () => window.removeEventListener('scroll', update);
  }
  document.addEventListener('astro:page-load', setupNavScroll);
  document.addEventListener('astro:before-swap', () => { off?.(); off = null; });
</script>
