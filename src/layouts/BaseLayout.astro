---
import '@fontsource/inter-tight/400.css';
import '@fontsource/inter-tight/400-italic.css';
import '@fontsource/inter-tight/500.css';
import '@fontsource/inter-tight/700.css';
import '@fontsource/victor-mono/400.css';
import '@fontsource/victor-mono/700.css';
import '@fontsource/redaction-35/400.css';
import '@fontsource/redaction-35/700.css';
import '../styles/tokens.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../utils/url';
import { ADOBE_KIT_ID } from '../config';
// Preloaded so Victor Mono is ready on first paint (no flash of a fallback mono font).
import victorMono400 from '@fontsource/victor-mono/files/victor-mono-latin-400-normal.woff2?url';
import victorMono700 from '@fontsource/victor-mono/files/victor-mono-latin-700-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  nav?: 'gold' | 'dark' | 'paper' | false;
  footer?: boolean;
}
const { title, description, nav = 'paper', footer = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Pivot Log</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2cd53" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('/favicon-16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png')} />
    <link rel="preload" href={victorMono400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={victorMono700} as="font" type="font/woff2" crossorigin />
    {ADOBE_KIT_ID && <link rel="stylesheet" href={`https://use.typekit.net/${ADOBE_KIT_ID}.css`} />}
    {ADOBE_KIT_ID && (
      <script is:inline data-astro-rerun>
        document.fonts.ready.then(function () {
          if (document.fonts.check('700 1em aktiv-grotesk')) document.documentElement.classList.add('fonts-adobe');
        });
      </script>
    )}
    <ClientRouter />
  </head>
  <body>
    {nav && <Nav theme={nav} />}
    <main>
      <slot />
    </main>
    {footer && <Footer />}
  </body>
</html>
